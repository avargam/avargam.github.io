---
/**
 * Repisa de Música: portadas en una repisa de pared. Al elegir un disco, el vinilo cae en el
 * tocadiscos y el mini reproductor toca su tema (`shelfClient.ts` maneja el audio). Los temas se
 * cambian en `src/data/music.json`.
 */
import { Image } from 'astro:assets';
import { music } from '../../../data/music';
import { MUSICA } from './shelf';
import art from './art/musica.svg?raw';

const tilt = [-3, 2, -1, 3, -2, 1];
const { platter } = MUSICA;
---

<div
  id="musica"
  class="topic music pointer-events-none absolute inset-0"
  data-item-detail="musica"
  data-sub-topic="musica"
>
  <svg
    class="absolute inset-0"
    width="1600"
    height="1612"
    viewBox="0 0 1600 1612"
    aria-hidden="true"
  >
    <g set:html={art} />
  </svg>

  {music.map((song, k) => (
    <a
      href={`#musica-${song.id}`}
      class="sub-object lp"
      style={`left:${MUSICA.x + k * MUSICA.step}px;top:${MUSICA.top}px;--r:${tilt[k % tilt.length]}deg;--k:${k}`}
      data-sub={`musica-${song.id}`}
      data-cover-x={MUSICA.x + k * MUSICA.step + MUSICA.size / 2}
      data-cover-y={MUSICA.top - 12 + MUSICA.size / 2}
      aria-controls={`musica-${song.id}`}
      aria-label={`${song.artist}: ${song.track}`}
    >
      <Image src={song.cover} alt="" width={MUSICA.size} height={MUSICA.size} densities={[1, 2]} />
    </a>
  ))}

  <!-- El vinilo vive sobre el plato; al elegir un disco, cae desde su portada (--sx, --sy). -->
  <div
    class="disc"
    style={`left:${platter.x - 65}px;top:${platter.y - 65}px`}
    data-disc
    aria-hidden="true"
  >
    <i></i>
  </div>
  <div
    class="shine-wrap"
    style={`left:${platter.x - 104}px;top:${platter.y - 104}px`}
    aria-hidden="true"
  >
    <div class="shine"></div>
  </div>
  {['♪', '♫', '♪'].map((note, k) => (
    <span
      class="note"
      style={`left:${1020 + k * 30}px;--k:${k};--dx:${(k - 1) * 30}px`}
      aria-hidden="true"
    >
      {note}
    </span>
  ))}

  <div class="player" data-player>
    <div class="lcd">
      <p class="idle" aria-hidden="true">
        ↖ Elige un disco
      </p>
      {music.map((song) => (
        <section
          id={`musica-${song.id}`}
          class="sub-detail song"
          data-sub-detail={`musica-${song.id}`}
          data-audio={song.audio}
          aria-label={`${song.artist}: ${song.track}`}
        >
          <Image src={song.cover} alt="" width={74} height={74} densities={[1, 2]} />
          <div class="meta">
            <small>SONANDO AHORA</small>
            <b>{song.track}</b>
            <span>{song.artist}</span>
            <span>
              {song.album} · {song.year}
            </span>
            <div class="progress" aria-hidden="true">
              <em data-time>0:00</em>
              <i></i>
              <em data-duration>–:––</em>
            </div>
          </div>
        </section>
      ))}
    </div>
    <div class="controls">
      <button type="button" data-player-action="prev" aria-label="Disco anterior">
        ◀◀
      </button>
      <button type="button" data-player-action="toggle" class="toggle" aria-label="Pausar">
        ❚❚
      </button>
      <button type="button" data-player-action="next" aria-label="Disco siguiente">
        ▶▶
      </button>
    </div>
    <audio preload="none" data-audio-player></audio>
  </div>
</div>

<style>
  .lp {
    position: absolute;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border: 4px solid var(--color-plum);
    border-radius: 4px;
    background: var(--color-indigo);
    box-shadow: 3px 4px 0 rgb(42 27 107 / 0.3);
    rotate: var(--r);
    transition:
      translate 0.35s cubic-bezier(0.3, 1.3, 0.5, 1),
      rotate 0.35s,
      box-shadow 0.3s;
  }

  .lp img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lp[aria-current] {
    box-shadow:
      0 0 0 4px var(--color-pink),
      3px 4px 0 rgb(42 27 107 / 0.3);
    rotate: 0deg;
    translate: 0 -12px;
  }

  /* El vinilo (con la portada en la etiqueta) queda sobre el plato, aplastado en perspectiva. */
  .disc {
    position: absolute;
    z-index: 2;
    display: none;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: repeating-radial-gradient(var(--color-night-deep) 0 3px, #241657 3px 5px);
    box-shadow: inset 0 0 0 4px var(--color-plum);
    pointer-events: none;
    scale: 1.6 0.34;
  }

  .disc i {
    position: absolute;
    inset: 34%;
    border: 2px solid var(--color-plum);
    border-radius: 50%;
    background: var(--cover) center / cover;
  }

  .music[data-open] .disc {
    display: block;
    animation: disc-drop 1s 0.15s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  }

  @keyframes disc-drop {
    0% {
      translate: var(--sx) var(--sy);
      scale: 0.7;
    }
    55% {
      translate: calc(var(--sx) * 0.4) calc(var(--sy) * 0.4 - 90px);
      scale: 1.2 0.8;
    }
  }

  .shine-wrap {
    position: absolute;
    width: 208px;
    height: 208px;
    opacity: 0;
    pointer-events: none;
    transform: scaleY(0.21);
  }

  .shine {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0 20%,
      rgb(255 255 255 / 0.35) 25%,
      transparent 30% 70%,
      rgb(255 255 255 / 0.25) 75%,
      transparent 80%
    );
  }

  .music[data-open] .shine-wrap {
    opacity: 1;
    animation: appear 0.1s 1.15s backwards;
  }

  .music[data-open] .shine {
    animation: spin 1.6s 1.15s linear infinite;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .music :global(.tonearm) {
    transform-box: fill-box;
    transform-origin: 100% 0;
    transition: transform 0.5s ease-in-out;
  }

  .music[data-open] :global(.tonearm) {
    transform: rotate(-16deg);
    transition-delay: 1.1s;
  }

  .music[data-open] :global(.speaker) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: beat 0.5s 1.5s ease-in-out infinite;
  }

  @keyframes beat {
    50% {
      transform: scale(1.04);
    }
  }

  .note {
    position: absolute;
    top: 1300px;
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    opacity: 0;
  }

  .music[data-open] .note {
    animation: float 2.4s calc(1.5s + var(--k) * 0.8s) ease-out infinite;
  }

  @keyframes float {
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      rotate: 18deg;
      translate: var(--dx) -110px;
    }
  }

  .music[data-paused] :is(.shine, .note, :global(.speaker)) {
    animation-play-state: paused;
  }

  /* ---------- mini reproductor ---------- */
  .player {
    position: absolute;
    top: 1384px;
    left: 254px;
    z-index: 1;
    display: grid;
    width: 388px;
    height: 154px;
    padding: 10px;
    grid-template-rows: 1fr auto;
    gap: 7px;
    border: 4px solid var(--color-plum);
    border-radius: 16px;
    background: var(--color-violet);
    box-shadow: 5px 6px 0 var(--color-plum);
    pointer-events: auto;
  }

  .lcd {
    position: relative;
    overflow: hidden;
    border: 3px solid var(--color-plum);
    border-radius: 8px;
    background: var(--color-night-deep);
    color: #cffff3;
  }

  /* scanlines */
  .lcd::after {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.14) 0 1px, transparent 1px 3px);
    content: '';
    pointer-events: none;
  }

  .lcd .idle {
    position: absolute;
    inset: 0;
    display: grid;
    margin: 0;
    place-items: center;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
  }

  .music[data-open] .lcd .idle {
    display: none;
  }

  .song {
    position: absolute;
    inset: 0;
    grid-template-columns: 74px 1fr;
    gap: 10px;
    align-items: center;
    padding: 6px 10px 6px 6px;
  }

  .song:is([data-open], :global(html:not(.js)) :target) {
    display: grid;
  }

  .song img {
    width: 74px;
    height: 74px;
    border-radius: 4px;
  }

  .meta {
    min-width: 0;
  }

  .meta small {
    display: block;
    color: var(--color-mint);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.25em;
  }

  .meta b {
    display: block;
    overflow: hidden;
    color: #fff;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta span {
    display: block;
    overflow: hidden;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 9px;
    font-weight: 700;
  }

  .progress i {
    height: 5px;
    flex: 1;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-night);
  }

  .progress i::before {
    display: block;
    width: calc(var(--p, 0) * 100%);
    height: 100%;
    background: var(--color-pink);
    content: '';
  }

  .controls {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .controls button {
    width: 34px;
    height: 26px;
    border: 3px solid var(--color-plum);
    border-radius: 13px;
    background: var(--color-wall);
    box-shadow: 0 3px 0 var(--color-plum);
    color: var(--color-plum);
    cursor: pointer;
    font-size: 11px;
    font-weight: 800;
  }

  .controls button:active {
    box-shadow: 0 1px 0 var(--color-plum);
    translate: 0 2px;
  }

  .controls .toggle {
    width: 48px;
    background: var(--color-pink);
    color: #fff;
  }

  .controls button:focus-visible {
    outline: 3px solid var(--color-hotpink);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .music[data-open] :is(.disc, .shine-wrap, .shine, .note, :global(.speaker)) {
      animation: none;
    }

    .music :global(.tonearm) {
      transition: none;
    }
  }
</style>
