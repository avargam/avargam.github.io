---
/**
 * Capa HTML de Fuera del código (escala 1:1 sobre la escena): Volver, chips de las repisas y
 * pista. La estantería se recorre con la cámara: ← → / ↑ ↓, la rueda, los chips o las clavijas.
 */
import { getSection } from '../../../data/sections';
import SectionShell from '../../ui/SectionShell.astro';
import ItemChips from '../../ui/ItemChips.astro';
import { fueraItems } from './shelf';

interface Props {
  active: boolean;
}

const { active } = Astro.props;
---

<SectionShell
  section={getSection('fuera-del-codigo')}
  active={active}
  hideTitle
  hint="Elige una repisa y un objeto · ← → ↑ ↓ o rueda para recorrer · Esc alejarse"
  touchHint="Toca una repisa y un objeto · desliza para recorrer"
>
  <ItemChips slot="chips" items={fueraItems} label="Repisas" />
</SectionShell>

<script>
  import { createItemNav } from '../../stage/itemNav';
  import { focusSceneRect, registerSection } from '../../stage/router';
  import { fueraItems, fueraItem, PAIRS } from './shelf';
  import { initShelf, type Shelf } from './shelfClient';

  const slug = 'fuera-del-codigo';
  /** Par de repisas a la vista cuando no hay una elegida (Esc vuelve a él). */
  let pair = 0;
  let active = !document.querySelector<HTMLElement>(`[data-overlay="${slug}"]`)?.hidden;
  let shelf: Shelf | null = null;

  const nav = createItemNav({
    slug,
    ids: fueraItems.map((i) => i.id),
    describe: (id) => fueraItem(id)?.name ?? '',
    focus(id, instant) {
      // Cambiar de repisa (o alejarse) cierra el objeto abierto. No cancela el que espera a que la
      // cámara llegue (si el cambio lo pidió otro clic, itemNav ya descarta la selección vieja).
      shelf?.close({ hash: false, cancel: false });
      const item = id ? fueraItem(id) : undefined;
      if (item) pair = item.pair;
      return focusSceneRect(slug, item?.frame ?? PAIRS[pair], instant);
    },
  });

  const root = document.querySelector<HTMLElement>(`[data-scene="${slug}"] [data-items]`);
  if (nav && root) {
    shelf = initShelf(root, nav);
    // Deep link a un objeto (#anime-frieren): la ruta ya viene con la sección abierta.
    if (active) shelf.openFromHash(true);

    registerSection(slug, {
      enter() {
        active = true;
        if (!shelf?.openFromHash()) nav.enter();
      },
      leave() {
        active = false;
        shelf?.close({ hash: false });
        pair = 0;
        nav.leave();
      },
      onKey(event) {
        if (shelf?.onKey(event)) return true;
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          nav.step(event.key === 'ArrowDown' ? 1 : -1);
          return true;
        }
        return nav.onKey(event);
      },
    });

    // Rueda: un gesto (aunque el trackpad mande muchos eventos) pasa una repisa, o un par si no
    // hay ninguna elegida.
    let lockedUntil = 0;
    addEventListener(
      'wheel',
      (event) => {
        if (!active || Math.abs(event.deltaY) < 20 || performance.now() < lockedUntil) return;
        lockedUntil = performance.now() + 700;
        const down = event.deltaY > 0;
        if (nav.selected()) nav.step(down ? 1 : -1);
        else if (pair !== (down ? 1 : 0)) {
          pair = down ? 1 : 0;
          void focusSceneRect(slug, PAIRS[pair]);
        }
      },
      { passive: true },
    );
  }
</script>
