---
/**
 * Repisa de Juegos: las cajas de mesa se abren y muestran su componente; los cartuchos entran a
 * la consola, que se acerca y reproduce un clip del juego. El d20 elige uno al azar (`shelfClient.ts`).
 */
import { games, type Game } from '../../../data/personal';
import { DETAIL_CENTER, GAMES } from './shelf';
import art from './art/juegos.svg?raw';
import dnd from './art/juegos/dnd.svg?raw';
import tren from './art/juegos/tren.svg?raw';
import munchkin from './art/juegos/munchkin.svg?raw';
import exit from './art/juegos/exit.svg?raw';
import dndIcon from './art/juegos/iconos/dnd.svg?raw';
import trenIcon from './art/juegos/iconos/tren.svg?raw';
import munchkinIcon from './art/juegos/iconos/munchkin.svg?raw';
import exitIcon from './art/juegos/iconos/exit.svg?raw';

const componentArt = { dnd, tren, munchkin, exit };
const boxIcon = { dnd: dndIcon, tren: trenIcon, munchkin: munchkinIcon, exit: exitIcon };
const center = DETAIL_CENTER.juegos;
const boards = games.filter((g) => g.kind === 'mesa');
const boxX = (k: number) => GAMES.box.x + GAMES.box.jitter[k % GAMES.box.jitter.length];
// Cajas apiladas: la primera arriba, cada una sobre las de más abajo.
const boxY = (k: number) => GAMES.box.base - boards.slice(k).reduce((sum, g) => sum + g.height, 0);
const cartX = (k: number) => GAMES.cart.x + (k - 4) * GAMES.cart.step;
const colors = (g: Game) => `--c:${g.color};--t:${g.textColor ?? 'var(--color-ink)'}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// La consola de la repisa: su centro (de donde sale la grande), la ranura y la pantalla, que
// replican las proporciones de `.console` a la escala de la consola chica.
const { handheld } = GAMES;
const mini = handheld.w / 600;
const consoleCenter = { x: handheld.x + handheld.w / 2, y: handheld.y + handheld.h / 2 };
const slotTop = { x: consoleCenter.x, y: handheld.y - 10 };
const miniScreen = `left:${handheld.x + 110 * mini}px;top:${handheld.y + 27 * mini}px;width:${380 * mini}px;height:${236 * mini}px`;
---

<div
  id="juegos"
  class="topic games pointer-events-none absolute inset-0"
  data-item-detail="juegos"
  data-sub-topic="juegos"
>
  <svg
    class="absolute inset-0"
    width="1600"
    height="1612"
    viewBox="0 0 1600 1612"
    aria-hidden="true"
  >
    <g set:html={art} />
  </svg>

  {games.map((g, k) =>
    g.kind === 'mesa' ? (
      <a
        href={`#${g.id}`}
        class="sub-object side gbox"
        style={`left:${boxX(k)}px;top:${boxY(k)}px;width:${g.width}px;height:${g.height}px;${colors(g)};--k:${k};--slide:${GAMES.box.slide}px`}
        data-sub={g.id}
        aria-controls={g.id}
      >
        <span class="face">
          <span class="name">{g.title}</span>
          <svg class="mark" viewBox="-10 -10 20 20" aria-hidden="true">
            <g set:html={boxIcon[g.art]} />
          </svg>
          <i aria-hidden="true">{k + 1}</i>
        </span>
      </a>
    ) : (
      <a
        href={`#${g.id}`}
        class="sub-object cart"
        style={`left:${cartX(k)}px;top:${GAMES.cart.top}px;${colors(g)};--k:${k}`}
        data-sub={g.id}
        aria-controls={g.id}
      >
        <span class="sr-only">{g.title}</span>
        <span aria-hidden="true">{g.label.join(' ')}</span>
        <b aria-hidden="true">{k + 1}</b>
      </a>
    ),
  )}

  <button
    type="button"
    class="d20-hit"
    style={`left:${GAMES.d20.x - 28}px;top:${GAMES.d20.y - 28}px`}
    data-roll
    aria-label="Tirar el d20: elige un juego al azar"
  ></button>
  <span
    class="roll-note"
    style={`left:${GAMES.d20.x - 198}px;top:${GAMES.d20.y - 102}px`}
    aria-hidden="true"
  >
    ¿a qué jugamos? ↓
  </span>

  {games.map((g, k) => {
    if (g.kind === 'mesa') {
      // La caja vuela desde su lugar en la repisa y se le va la tapa.
      const fx = boxX(k) + g.width / 2 - center.x;
      const fy = boxY(k) + g.height / 2 - center.y;
      return (
        <article
          id={g.id}
          class="sub-detail fly obox"
          style={`--fx:${fx}px;--fy:${fy}px;${colors(g)}`}
          data-sub-detail={g.id}
          aria-label={g.title}
        >
          <div class="tray">
            <svg
              class="art"
              viewBox="0 0 300 220"
              preserveAspectRatio="xMidYMid slice"
              aria-hidden="true"
            >
              <g set:html={componentArt[g.art]} />
            </svg>
            <div class="label reveal" style="--k:1">
              <span class="kick">JUEGO DE MESA</span>
              <h3>{g.title}</h3>
              <span class="genre">{g.genre}</span>
              <dl class="facts">
                {g.facts.map(([name, value]) => (
                  <div>
                    <dt>{name}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
          <div class="lid" aria-hidden="true">
            {g.title}
          </div>
          <a href="#juegos" class="close-x" data-sub-close aria-label={`Guardar ${g.title}`}>
            ✕
          </a>
        </article>
      );
    }
    // El cartucho entra a la consola de la repisa, que se enciende; la consola grande sale de ella.
    const cx = cartX(k) + GAMES.cart.w / 2;
    const cy = GAMES.cart.top + 18;
    return (
      <>
        <span class="handheld-screen" style={miniScreen} aria-hidden="true">
          ▶ {g.label.join(' ')}
        </span>
        <span
          class="cart-fly"
          style={`left:${cartX(k)}px;top:${GAMES.cart.top - 14}px;--c:${g.color};--fx:${slotTop.x - cx}px;--fy:${slotTop.y - cy}px`}
          aria-hidden="true"
        />
        <article
          id={g.id}
          class="sub-detail fly console"
          style={`--fx:${consoleCenter.x - center.x}px;--fy:${consoleCenter.y - center.y}px;${colors(g)}`}
          data-sub-detail={g.id}
          aria-label={g.title}
        >
          <div class="slot" aria-hidden="true" />
          <div class="body">
            <div class="dpad" aria-hidden="true" />
            <div class="screen">
              <h3 class="bar">▶ {g.title}</h3>
              {g.clip ? (
                <video
                  class="clip"
                  src={`${base}${g.clip}`}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                  data-clip-start
                />
              ) : (
                g.scenes.map((color, i) => (
                  <div
                    class="scene-placeholder"
                    style={`--i:${i};--a:${color};--b:${g.scenes[1 - i]}`}
                    aria-hidden="true"
                  >
                    <b>ESCENA {i + 1}</b>
                    <small>placeholder · clip de {g.title}</small>
                  </div>
                ))
              )}
              <p class="foot">
                <span>{g.genre}</span>
                <span>{g.facts[0][1]}</span>
              </p>
            </div>
            <div class="buttons" aria-hidden="true">
              <i />
              <i />
            </div>
          </div>
          <a href="#juegos" class="close-x" data-sub-close aria-label={`Apagar ${g.title}`}>
            ✕
          </a>
        </article>
      </>
    );
  })}

  <svg
    class="big-d20"
    style={`left:${GAMES.d20.x - 75}px;top:${GAMES.d20.y - 75}px;--fx:${center.x - GAMES.d20.x}px;--fy:${center.y - GAMES.d20.y}px`}
    viewBox="0 0 150 150"
    aria-hidden="true"
  >
    <!-- Sin contorno: el trazo del mismo color solo redondea las esquinas. -->
    <polygon
      points="75,8 133,41 133,109 75,142 17,109 17,41"
      fill="#FF6FA3"
      stroke="#FF6FA3"
      stroke-width="8"
      stroke-linejoin="round"
    ></polygon>
    <polygon
      points="75,30 118,100 32,100"
      fill="#F9DDF0"
      stroke="#F9DDF0"
      stroke-width="6"
      stroke-linejoin="round"
    ></polygon>
    <text x="75" y="88" text-anchor="middle">
      20
    </text>
  </svg>
</div>

<style>
  /* Los dados ruedan al llegar a la repisa. */
  .games[data-active] :global(.die) {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: roll 0.9s 0.2s cubic-bezier(0.3, 0.8, 0.4, 1) both;
  }

  .games[data-active] :global(.die2) {
    animation-delay: 0.32s;
  }

  .games[data-active] :global(.d20) {
    animation-delay: 0.44s;
  }

  @keyframes roll {
    0% {
      transform: translate(-60px, -50px) rotate(-260deg);
    }
    60% {
      transform: translate(4px, 0) rotate(10deg);
    }
  }

  /*
   * Caja de mesa acostada: la tapa (`.face`, con el título, el ícono y el número) cubre el 64 % de
   * arriba y sobresale 3 px por lado de la base, más oscura, para que se lea como caja y no como
   * libro.
   */
  .gbox {
    padding: 0 3px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--c) 72%, #1b1245) content-box;
  }

  .face {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    height: 64%;
    align-items: center;
    gap: 8px;
    padding: 0 8px 0 14px;
    border-radius: 5px;
    background: var(--c);
    color: var(--t);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
  }

  .face .name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mark {
    width: 18px;
    height: 18px;
    flex: none;
    fill: currentColor;
  }

  .mark :global(.cut) {
    fill: var(--c);
  }

  .face i {
    display: grid;
    width: 20px;
    height: 20px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: #fbf4ff;
    color: #2e2170;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-style: normal;
  }

  .cart {
    position: absolute;
    width: 46px;
    height: 64px;
    border-radius: 6px;
    background: var(--c);
  }

  /* contactos del cartucho */
  .cart::before {
    position: absolute;
    right: 9px;
    bottom: 7px;
    left: 9px;
    height: 10px;
    background: repeating-linear-gradient(90deg, rgb(46 33 112 / 0.4) 0 3px, transparent 3px 6px);
    content: '';
  }

  .cart span[aria-hidden] {
    position: absolute;
    top: 9px;
    right: 5px;
    left: 5px;
    display: grid;
    height: 28px;
    place-items: center;
    border-radius: 4px;
    background: #fbf4ff;
    color: #2e2170;
    font-size: 6.5px;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  .cart b {
    position: absolute;
    top: -7px;
    right: -7px;
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    border-radius: 50%;
    background: #2e2170;
    color: #fbf4ff;
    font-size: 9px;
  }

  .cart[aria-current] {
    translate: 0 -14px;
  }

  /* El juego que eligió el d20 brilla antes de abrirse. */
  .sub-object.lucky {
    animation: lucky 0.45s ease-in-out 3 !important;
  }

  @keyframes lucky {
    50% {
      box-shadow: 0 0 0 8px var(--color-hotpink);
    }
  }

  /* ---------- d20 ---------- */
  .d20-hit {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
  }

  .games[data-active] .d20-hit {
    animation: ping 1.4s 1.2s ease-out infinite;
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 rgb(255 79 163 / 0.7);
    }
    100% {
      box-shadow: 0 0 0 22px rgb(255 79 163 / 0);
    }
  }

  .roll-note {
    position: absolute;
    color: var(--color-plum);
    font-family: var(--font-hand);
    font-size: 26px;
    opacity: 0;
    rotate: -5deg;
    transition: opacity 0.3s;
  }

  .games[data-active]:not([data-open], [data-rolling]) .roll-note {
    opacity: 1;
    transition-delay: 0.9s;
  }

  .big-d20 {
    position: absolute;
    z-index: 3;
    width: 150px;
    height: 150px;
    visibility: hidden;
  }

  .big-d20 text {
    fill: #2e2170;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
  }

  /* Rueda hacia el frente (al centro del detalle), muestra el número y se desvanece. */
  .games[data-rolling] .big-d20 {
    visibility: visible;
    animation:
      big-roll 1.1s cubic-bezier(0.3, 0.7, 0.4, 1) forwards,
      big-out 0.3s 2s forwards;
  }

  @keyframes big-roll {
    0% {
      scale: 0.3;
    }
    45% {
      translate: calc(var(--fx) * 0.5) calc(var(--fy) - 120px);
      scale: 0.8;
    }
    100% {
      translate: var(--fx) var(--fy);
      rotate: 1080deg;
    }
  }

  @keyframes big-out {
    from {
      translate: var(--fx) var(--fy);
    }
    to {
      opacity: 0;
      translate: var(--fx) var(--fy);
      scale: 1.3;
    }
  }

  /* ---------- caja abierta ---------- */
  .obox {
    top: 126px;
    left: 500px;
    width: 600px;
    height: 272px;
  }

  .tray {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 14px;
    padding: 15px;
    border-radius: 15px;
    background: var(--c);
  }

  .tray .art {
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  .label {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border-radius: 10px;
    background: #fbf4ff;
  }

  /* La ficha de la caja en los colores de la paleta (los estilos comunes los comparte Anime). */
  .label .kick {
    color: #9a8ce0;
  }

  .label h3 {
    color: #4b3a8f;
  }

  .label .genre {
    color: #6a56b8;
  }

  .obox .label :global(.facts div) {
    border-top: 2px solid #dad0ff;
  }

  .obox .label :global(.facts dd) {
    color: #4b3a8f;
  }

  /* La tapa (encima, con el título) sale volando. En reposo ya no está. */
  .lid {
    position: absolute;
    inset: -6px;
    display: grid;
    padding: 20px;
    place-items: center;
    border-radius: 18px;
    background: var(--c);
    box-shadow: inset 0 -16px 0 rgb(27 18 69 / 0.18);
    color: var(--t);
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    line-height: 1.05;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }

  .obox[data-open] .lid {
    animation: lid-off 0.7s 0.55s cubic-bezier(0.5, 0, 0.3, 1) backwards;
  }

  @keyframes lid-off {
    0%,
    35% {
      opacity: 1;
    }
    35% {
      translate: 0 -50px;
      rotate: -3deg;
    }
    100% {
      translate: 300px -240px;
      rotate: 20deg;
    }
  }

  /* ---------- consola ---------- */
  /* La pantalla de la consola de la repisa (posición y tamaño desde `GAMES.handheld`). */
  .handheld-screen {
    position: absolute;
    display: none;
    padding: 4px;
    place-items: center;
    overflow: hidden;
    border-radius: 3px;
    background: #2e2170;
    color: #fbf4ff;
    font-family: var(--font-display);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-align: center;
  }

  .handheld-screen:has(+ .cart-fly + .console:is([data-open], html:not(.js) :target)) {
    display: grid;
    animation: power-on 0.3s 0.45s steps(3) backwards;
  }

  @keyframes power-on {
    from {
      opacity: 0;
    }
  }

  .cart-fly {
    position: absolute;
    z-index: 2;
    width: 46px;
    height: 64px;
    border-radius: 6px;
    background: var(--c);
    opacity: 0;
    pointer-events: none;
  }

  .cart-fly:has(+ .console[data-open]) {
    animation: cart-in 0.55s cubic-bezier(0.4, 0, 0.3, 1);
  }

  @keyframes cart-in {
    0% {
      opacity: 1;
    }
    60% {
      opacity: 1;
      translate: calc(var(--fx) * 0.6) calc(var(--fy) * 0.6 - 70px);
      rotate: 20deg;
    }
    /* entra a la ranura de la consola chica, que mide la mitad del cartucho */
    100% {
      translate: var(--fx) var(--fy);
      scale: 0.5;
    }
  }

  /* Sale de la consola de la repisa, que está derecha y mide 0,32 de esta. */
  .console {
    --delay: 0.5s;
    --fly-rot: 0deg;
    top: 118px;
    left: 500px;
    width: 600px;
    height: 290px;
  }

  .console .body {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 110px 1fr 110px;
    align-items: center;
    border-radius: 44px;
    background: #6a56b8;
  }

  .slot {
    position: absolute;
    top: -34px;
    left: 50%;
    width: 70px;
    height: 44px;
    margin-left: -35px;
    border-radius: 8px 8px 0 0;
    background: var(--c);
  }

  .dpad {
    position: relative;
    width: 60px;
    height: 60px;
    margin: auto;
  }

  .dpad::before,
  .dpad::after {
    position: absolute;
    border-radius: 7px;
    background: #2e2170;
    content: '';
  }

  .dpad::before {
    top: 0;
    left: 20px;
    width: 20px;
    height: 60px;
  }

  .dpad::after {
    top: 20px;
    left: 0;
    width: 60px;
    height: 20px;
  }

  .buttons {
    display: grid;
    width: 70px;
    margin: auto;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .buttons i {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-pink);
  }

  .buttons i + i {
    background: #a9c4f5;
    translate: 0 -16px;
  }

  /* La pantalla con su marco índigo (una sombra sólida, para no cambiar su tamaño). */
  .screen {
    position: relative;
    height: 236px;
    overflow: hidden;
    border-radius: 10px;
    background: #2e2170;
    box-shadow: 0 0 0 7px #2e2170;
    color: #fbf4ff;
  }

  .bar,
  .foot {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 1;
    margin: 0;
    padding: 6px 10px;
    background: rgb(46 33 112 / 0.85);
  }

  .screen .bar {
    top: 0;
    color: #fbf4ff;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .foot {
    bottom: 0;
    display: flex;
    justify-content: space-between;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 700;
  }

  /* El clip aparece cuando se enciende la pantalla, y ahí empieza a reproducirse (`data-clip-start`). */
  .clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .console[data-open] .clip {
    animation: clip-in 0.3s 1.2s backwards;
  }

  @keyframes clip-in {
    from {
      opacity: 0;
    }
  }

  .console .scene-placeholder {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .console .scene-placeholder:first-of-type {
    opacity: 1;
  }

  .console[data-open] .scene-placeholder {
    animation: scene-cycle 8s calc(1.2s + var(--i) * 4s) infinite backwards;
  }

  @keyframes scene-cycle {
    0%,
    47% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .games[data-active] :global(.die),
    .games[data-active] .d20-hit,
    .sub-object.lucky,
    .obox[data-open] .lid,
    .handheld-screen,
    .cart-fly,
    .console[data-open] .clip,
    .console[data-open] .scene-placeholder {
      animation: none !important;
    }

    .games[data-rolling] .big-d20 {
      animation: none;
      translate: var(--fx) var(--fy);
    }
  }
</style>
