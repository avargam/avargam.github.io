---
/**
 * Escena de Fuera del código: la estantería completa, con una repisa por tema. En el cuarto se ven
 * las 4 repisas; al entrar, la cámara encuadra las dos de arriba y baja por ella al recorrerla.
 * Cada repisa es un ítem (`fueraItems`); sus objetos (tomos, cajas, discos) se eligen dentro de
 * ella y muestran su detalle (`shelfClient.ts`).
 *
 * Capas, de atrás hacia adelante: fondo, zonas clicables de las repisas, objetos de cada repisa,
 * frente (tablas y laterales), placas y clavijas. Los detalles abiertos van encima de todo (z-index).
 */
import { getSection, type ZoomSection } from '../../../data/sections';
import { cameraForSceneRect, cameraTransform, rectStyle } from '../../stage/geometry';
import { fueraItems, VH, VT } from './shelf';
import GamesShelf from './GamesShelf.astro';
import AnimeShelf from './AnimeShelf.astro';
import CinemaShelf from './CinemaShelf.astro';
import MusicShelf from './MusicShelf.astro';
import back from './art/back.svg?raw';
import front from './art/front.svg?raw';

const section = getSection('fuera-del-codigo') as ZoomSection;

/** Placa y clavija de la repisa elegida, en rosa. */
const selectedCss = fueraItems
  .map(
    ({
      id,
    }) => `[data-items][data-selected="${id}"] [data-plate="${id}"] { background: var(--color-pink); }
[data-items][data-selected="${id}"] [data-peg="${id}"] { background: var(--color-pink); box-shadow: 0 0 10px var(--color-pink); }`,
  )
  .join('\n');

/** Sin JS, una clavija (#repisa) o un objeto (#anime-frieren) acercan la cámara a su repisa. */
const noJsCss = fueraItems
  .map(
    ({ id, frame }) =>
      `html:not(.js) [data-camera]:has(#${id}:target, [data-sub-topic="${id}"] [data-sub-detail]:target) { transform: ${cameraTransform(cameraForSceneRect(section, frame))} !important; }`,
  )
  .join('\n');
---

<div class="shelf absolute inset-0" data-items>
  <svg
    class="absolute inset-0"
    width="1600"
    height="1612"
    viewBox="0 0 1600 1612"
    aria-hidden="true"
  >
    <g set:html={back} />
  </svg>

  {fueraItems.map((item) => (
    <button
      type="button"
      class="topic-hit absolute"
      style={rectStyle(item.hit)}
      data-item-hit={item.id}
      aria-label={item.name}
      aria-controls={item.id}
      aria-pressed="false"
    />
  ))}

  <GamesShelf />
  <AnimeShelf />
  <CinemaShelf />
  <MusicShelf />

  <svg
    class="pointer-events-none absolute inset-0"
    width="1600"
    height="1612"
    viewBox="0 0 1600 1612"
    aria-hidden="true"
  >
    <g set:html={front} />
  </svg>

  {fueraItems.map((item, i) => (
    <span
      class="plate"
      style={`top:${VT + i * VH + 337}px`}
      data-plate={item.id}
      aria-hidden="true"
    >
      {item.plate}
    </span>
  ))}
  <!-- Clavijas del lateral: recorren la estantería con el mouse (los chips lo hacen con teclado). -->
  {fueraItems.map((item, i) => (
    <a
      href={`#${item.id}`}
      class="peg"
      style={`top:${VT + i * VH + 154}px`}
      data-peg={item.id}
      tabindex="-1"
      aria-hidden="true"
    ></a>
  ))}
</div>

<style is:inline set:html={selectedCss} />
<style is:inline set:html={noJsCss} />

<style>
  .topic-hit {
    border-radius: 10px;
    cursor: pointer;
  }

  .topic-hit:focus-visible {
    outline: none;
  }

  /* Contorno punteado al pasar sobre una repisa que no está elegida. */
  .topic-hit:not([aria-pressed='true']):is(:hover, :focus-visible) {
    outline: 5px dashed var(--color-hotpink);
    outline-offset: 4px;
  }

  .plate {
    position: absolute;
    left: 262px;
    display: grid;
    height: 18px;
    padding: 0 14px;
    place-items: center;
    border: 2.5px solid var(--color-plum);
    border-radius: 4px;
    background: #f3d37a;
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    transition: background 0.3s;
  }

  .peg {
    position: absolute;
    left: 1374px;
    width: 22px;
    height: 22px;
    border: 3px solid var(--color-indigo);
    border-radius: 50%;
    background: var(--color-cabinet);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.2);
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }

  /* ---------- objetos de las repisas (comunes) ---------- */
  .shelf :global(.sub-object) {
    position: absolute;
    color: var(--t, var(--color-ink));
    cursor: pointer;
    pointer-events: auto;
    text-decoration: none;
    transition: translate 0.35s cubic-bezier(0.3, 1.3, 0.5, 1);
  }

  .shelf :global(.sub-object:focus-visible) {
    outline: 4px solid var(--color-hotpink);
    outline-offset: 3px;
  }

  .shelf :global(.topic[data-active] .sub-object:not([aria-current]):hover) {
    translate: 0 -10px;
  }

  /* Al llegar a la repisa, los objetos se asoman uno tras otro. */
  .shelf :global(.topic[data-active] .sub-object) {
    animation: nudge 0.45s calc(0.6s + var(--k, 0) * 0.07s) ease-in-out;
  }

  @keyframes nudge {
    50% {
      translate: 0 -16px;
    }
  }

  /* Lomo (tomo, caja de mesa o de DVD) con el título en vertical. */
  .shelf :global(.spine) {
    display: flex;
    justify-content: center;
    padding: 30px 0 34px;
    border: 4px solid var(--color-plum);
    border-radius: 3px;
    background: var(--c);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.08;
  }

  .shelf :global(.spine::before) {
    position: absolute;
    top: 12px;
    right: 0;
    left: 0;
    height: 9px;
    background: rgb(255 255 255 / 0.55);
    content: '';
  }

  .shelf :global(.spine span) {
    letter-spacing: 0.02em;
    text-align: center;
    writing-mode: vertical-rl;
  }

  .shelf :global(.spine i) {
    position: absolute;
    bottom: 8px;
    left: 50%;
    display: grid;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    place-items: center;
    border: 2.5px solid var(--color-plum);
    border-radius: 50%;
    background: #fff;
    color: var(--color-plum);
    font-size: 10px;
    font-style: normal;
  }

  /* ---------- detalle de un objeto (comunes) ---------- */
  .shelf :global(:where(.sub-detail)) {
    position: absolute;
    z-index: 2;
    display: none;
  }

  .shelf :global(:where(.sub-detail:is([data-open], html:not(.js) :target))) {
    display: block;
  }

  /* Libro, caja y consola vuelan al frente desde su objeto (--fx, --fy) y reciben sus clics. */
  .shelf :global(.fly) {
    pointer-events: auto;
  }

  .shelf :global(.fly[data-open]) {
    animation: fly 0.55s var(--delay, 0s) cubic-bezier(0.3, 1, 0.4, 1) backwards;
  }

  @keyframes fly {
    0% {
      opacity: 0;
      transform: translate(var(--fx), var(--fy)) scale(0.32) rotate(-6deg);
    }
    10% {
      opacity: 1;
    }
  }

  .shelf :global(.sub-detail[data-open] .reveal) {
    animation: reveal 0.35s calc(var(--delay, 0s) + 0.9s + var(--k, 0) * 0.08s) backwards;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  .shelf :global(.close-x) {
    position: absolute;
    top: -18px;
    right: -18px;
    z-index: 3;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 4px solid var(--color-plum);
    border-radius: 50%;
    background: var(--color-pink);
    box-shadow: 3px 4px 0 var(--color-plum);
    color: #fff;
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    pointer-events: auto;
    text-decoration: none;
  }

  .shelf :global(.close-x:is(:hover, :focus-visible)) {
    background: var(--color-hotpink);
    outline: none;
    scale: 1.08;
  }

  .shelf :global(.sub-detail[data-open] .close-x) {
    animation: reveal 0.3s calc(var(--delay, 0s) + 1.1s) backwards;
  }

  .shelf :global(.kick) {
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .shelf :global(:where(.sub-detail) h3) {
    margin: 4px 0 6px;
    font-weight: 800;
    font-size: 26px;
    line-height: 1.05;
  }

  .shelf :global(.genre) {
    margin-bottom: 4px;
    color: var(--color-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .shelf :global(.facts) {
    display: grid;
    margin: auto 0 0;
    gap: 3px;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 600;
  }

  .shelf :global(.facts div) {
    display: flex;
    justify-content: space-between;
    padding-top: 3px;
    border-top: 2px dotted #d9c9ef;
  }

  .shelf :global(.facts dd) {
    margin: 0;
    color: var(--color-plum);
    font-weight: 800;
  }

  /* Escena de relleno (mientras no haya clip): degradado, marco punteado y su nombre. */
  .shelf :global(.scene-placeholder) {
    display: grid;
    place-content: center;
    gap: 4px;
    background: linear-gradient(160deg, var(--a), var(--b));
    color: #fff;
    text-align: center;
  }

  .shelf :global(.scene-placeholder::before) {
    position: absolute;
    inset: 10px;
    border: 3px dashed rgb(255 255 255 / 0.5);
    border-radius: 6px;
    content: '';
  }

  .shelf :global(.scene-placeholder b) {
    font-family: var(--font-display);
    font-size: 24px;
  }

  .shelf :global(.scene-placeholder small) {
    font-size: 10px;
    font-weight: 700;
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf :global(.topic[data-active] .sub-object),
    .shelf :global(.fly[data-open]),
    .shelf :global(.sub-detail[data-open] :is(.reveal, .close-x)) {
      animation: none;
    }

    .shelf :global(.sub-object),
    .plate,
    .peg {
      transition: none;
    }
  }
</style>
