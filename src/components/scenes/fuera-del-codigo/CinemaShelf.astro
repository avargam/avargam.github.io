---
/**
 * Repisa de Cine: al llegar, baja el telón y se enciende el proyector. Al elegir una caja, se tira
 * del telón, el disco entra al proyector y, tras una cuenta regresiva, la pantalla muestra dos
 * escenas de la película (un clip de 8 s de `public/` o, mientras falte, escenas de relleno) y
 * aparece la entrada. La claqueta marca la toma cada vez que se le hace clic.
 */
import { films } from '../../../data/personal';
import { CINE } from './shelf';
import art from './art/cine.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Cajas apiladas: la primera arriba.
const caseX = (k: number) => CINE.x + CINE.jitter[k % CINE.jitter.length];
const caseY = (k: number) => CINE.base - (films.length - k) * CINE.step + CINE.step - CINE.h;
const screenStyle = `left:${CINE.screen.x}px;top:${CINE.screen.y}px;width:${CINE.screen.w}px;height:${CINE.screen.h}px`;
const clapStyle = `left:${CINE.clapper.x}px;top:${CINE.clapper.y}px;width:${CINE.clapper.w}px;height:${CINE.clapper.h}px`;
---

<div
  id="cine"
  class="topic cinema pointer-events-none absolute inset-0"
  data-item-detail="cine"
  data-sub-topic="cine"
>
  <svg
    class="absolute inset-0"
    width="1600"
    height="1612"
    viewBox="0 0 1600 1612"
    aria-hidden="true"
  >
    <g set:html={art} />
    <polygon
      class="beam"
      points="1086,1068 1036,882 1036,1108 1086,1086"
      fill="url(#fuera-beam)"
    ></polygon>
  </svg>

  <button
    type="button"
    class="clap-hit"
    style={clapStyle}
    data-clap
    aria-label="Marcar la toma con la claqueta"
  ></button>

  <div class="idle" style={screenStyle} aria-hidden="true">
    <small>FUNCIÓN DE HOY</small>
    <b>← Elige una película</b>
  </div>

  {films.map((f, k) => (
    <a
      href={`#${f.id}`}
      class="sub-object spine side case"
      style={`left:${caseX(k)}px;top:${caseY(k)}px;width:${CINE.w}px;height:${CINE.h}px;--c:${f.color};--t:${f.textColor ?? '#fff'};--k:${k};--slide:${CINE.slide}px`}
      data-sub={f.id}
      aria-controls={f.id}
    >
      <span>{f.title}</span>
    </a>
  ))}

  {films.map((f, k) => {
    // El disco sale del extremo de la caja (que se corre a la derecha) y entra al proyector.
    const cx = caseX(k) + CINE.slide + CINE.w - 20;
    const cy = caseY(k) + CINE.h / 2;
    return (
      <>
        <span
          class="dvd"
          style={`left:${cx - 32}px;top:${cy - 32}px;--fx:${CINE.lens.x - cx}px;--fy:${CINE.lens.y - cy}px`}
          aria-hidden="true"
        />
        <article id={f.id} class="sub-detail film" data-sub-detail={f.id} aria-label={f.title}>
          <div class="film-screen" style={screenStyle} data-sub-focus>
            <div class="count" aria-hidden="true">
              {['3', '2', '1'].map((n, i) => (
                <span style={`--i:${i}`}>{n}</span>
              ))}
            </div>
            <div class="video" data-clip-start>
              {f.clip ? (
                <video
                  class="scene"
                  src={`${base}${f.clip}`}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                />
              ) : (
                f.scenes.map((color, i) => (
                  <div
                    class="scene scene-placeholder"
                    style={`--i:${i};--a:${color};--b:${f.scenes[1 - i]}`}
                    aria-hidden="true"
                  >
                    <b>ESCENA {i + 1}</b>
                    <small>placeholder · clip de {f.title}</small>
                  </div>
                ))
              )}
              <i class="progress" aria-hidden="true" />
            </div>
            <a href="#cine" class="close-x" data-sub-close aria-label={`Detener ${f.title}`}>
              ✕
            </a>
          </div>
          <p class="ticket">
            <small>
              ENTRADA · FUNCIÓN {k + 1} DE {films.length}
            </small>
            <br />
            <b>{f.title}</b>
            <em>
              {f.year} · {f.director}
            </em>
          </p>
        </article>
      </>
    );
  })}
</div>

<style>
  /* El telón está enrollado; al llegar a la repisa baja. */
  .cinema :global(.screen) {
    transform: scaleY(0);
    transform-box: fill-box;
    transform-origin: 50% 0;
  }

  .cinema[data-active] :global(.screen),
  :global(html:not(.js)) .cinema:has(:target) :global(.screen) {
    transform: none;
  }

  .cinema[data-active] :global(.screen) {
    animation: unroll 0.7s cubic-bezier(0.3, 1.2, 0.5, 1) backwards;
  }

  @keyframes unroll {
    from {
      transform: scaleY(0);
    }
  }

  /*
   * El tirante queda fuera del telón para verse colgando bajo la barra mientras está enrollado
   * (232 px más arriba) y baja con su borde, con la misma curva.
   */
  .cinema :global(.pull) {
    transform: translateY(-232px);
  }

  .cinema[data-active] :global(.pull),
  :global(html:not(.js)) .cinema:has(:target) :global(.pull) {
    transform: none;
  }

  .cinema[data-active] :global(.pull) {
    animation: pull-unroll 0.7s cubic-bezier(0.3, 1.2, 0.5, 1) backwards;
  }

  @keyframes pull-unroll {
    from {
      transform: translateY(-232px);
    }
  }

  /*
   * Al elegir una película se tira del tirante: baja 12 px, el telón se estira lo mismo y ambos
   * rebotan de vuelta. Va en `.tug`, dentro de cada uno, para no pisar la animación de bajada.
   */
  .cinema :global(.screen .tug) {
    transform-box: fill-box;
    transform-origin: 50% 0;
  }

  .cinema:has(.film[data-open]) :global(.screen .tug) {
    animation: tug-stretch 0.7s cubic-bezier(0.4, 0, 0.3, 1);
  }

  .cinema:has(.film[data-open]) :global(.pull .tug) {
    animation: tug 0.7s cubic-bezier(0.4, 0, 0.3, 1);
  }

  @keyframes tug-stretch {
    35% {
      transform: scaleY(1.052);
    }
    65% {
      transform: scaleY(0.99);
    }
  }

  @keyframes tug {
    35% {
      transform: translateY(12px);
    }
    65% {
      transform: translateY(-2px);
    }
  }

  .beam {
    opacity: 0;
  }

  .cinema[data-active] .beam {
    opacity: 1;
    animation:
      flicker 0.25s 0.7s steps(2) backwards,
      flicker-idle 3s 1.2s infinite;
  }

  @keyframes flicker {
    from {
      opacity: 0;
    }
  }

  @keyframes flicker-idle {
    50% {
      opacity: 0.82;
    }
  }

  .cinema[data-active] :global(.lens) {
    animation: glow 1s 0.6s infinite alternate;
  }

  @keyframes glow {
    to {
      fill: #fff;
    }
  }

  .idle {
    position: absolute;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .idle small {
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.3em;
  }

  .idle b {
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.05;
  }

  .cinema[data-active]:not([data-open]) .idle {
    opacity: 1;
    transition-delay: 1s;
  }

  /*
   * Caja acostada en la pila: sin el borde de los lomos y con el título en horizontal. Los
   * selectores llevan `.cinema` para ganarle a las reglas comunes de `.spine` y `.sub-object`.
   */
  .cinema .case {
    align-items: center;
    justify-content: flex-start;
    padding: 0 0 0 32px;
    border: 0;
    border-radius: 6px;
    font-size: 12.5px;
  }

  /* la franja clara del lomo, ahora vertical en el extremo izquierdo */
  .cinema .case::before {
    top: 0;
    bottom: 0;
    left: 14px;
    width: 8px;
    height: auto;
    background: rgb(255 255 255 / 0.4);
  }

  .cinema .case span {
    writing-mode: horizontal-tb;
  }

  /* el disco que asoma de la caja */
  .case::after {
    position: absolute;
    top: 50%;
    right: 11px;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-radius: 50%;
    background: radial-gradient(circle closest-side, var(--c) 0 38%, var(--color-wall) 40%);
    content: '';
  }

  /* Zona clicable de la claqueta: solo con la repisa elegida (si no, el clic elige la repisa). */
  .clap-hit {
    position: absolute;
    border-radius: 12px;
    cursor: pointer;
  }

  .cinema[data-active] .clap-hit {
    pointer-events: auto;
  }

  .clap-hit:focus-visible {
    outline: 4px solid var(--color-hotpink);
    outline-offset: 3px;
  }

  /*
   * La claqueta marca la toma con cada clic (`data-clap`): la tapa se abre más, golpea cerrada (con
   * un rebote) y vuelve a quedar entreabierta; el cuerpo da un saltito con el golpe. Al pasar
   * encima, la tapa se levanta un poco.
   */
  .cinema :global(:is(.clapper, .clap-lid)) {
    transform-box: view-box;
  }

  .cinema :global(.clapper) {
    transform-origin: 600px 1180px;
  }

  .cinema :global(.clap-lid) {
    transform-origin: 563px 1100px;
    transition: transform 0.2s;
  }

  .cinema[data-active]:has(.clap-hit:hover) :global(.clap-lid) {
    transform: rotate(-6deg);
  }

  .cinema[data-clap] :global(.clap-lid) {
    animation: clap 0.9s cubic-bezier(0.5, 0, 0.5, 1);
  }

  .cinema[data-clap] :global(.clapper) {
    animation: clap-hop 0.9s ease-out;
  }

  @keyframes clap {
    40% {
      transform: rotate(-18deg);
    }
    58% {
      transform: rotate(14deg);
      animation-timing-function: ease-out;
    }
    66% {
      transform: rotate(10deg);
    }
    72%,
    82% {
      transform: rotate(14deg);
    }
  }

  @keyframes clap-hop {
    55% {
      transform: none;
    }
    62% {
      transform: translateY(-7px) rotate(-1.5deg);
    }
    74% {
      transform: none;
    }
  }

  .dvd {
    position: absolute;
    z-index: 2;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    /* hueco al centro, anillo claro y dos brillos sobre el lila */
    background:
      radial-gradient(
        circle closest-side,
        transparent 0 13%,
        #e9e3ff 14% 23%,
        #fbf4ff 24% 35%,
        transparent 36%
      ),
      conic-gradient(
        #dad0ff 0 10deg,
        #f9ddf0 10deg 50deg,
        #dad0ff 50deg 190deg,
        #a9c4f5 190deg 230deg,
        #dad0ff 230deg
      );
    opacity: 0;
    pointer-events: none;
  }

  .dvd:has(+ .film[data-open]) {
    animation: dvd-in 0.85s 0.3s cubic-bezier(0.4, 0, 0.3, 1) backwards;
  }

  @keyframes dvd-in {
    0% {
      opacity: 1;
      scale: 0.7;
    }
    55% {
      opacity: 1;
      translate: calc(var(--fx) * 0.55) calc(var(--fy) * 0.55 - 150px);
      scale: 1.1;
    }
    90% {
      opacity: 1;
      scale: 0.55;
    }
    100% {
      opacity: 0;
      translate: var(--fx) var(--fy);
      rotate: 900deg;
      scale: 0.4;
    }
  }

  .film {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .film-screen {
    position: absolute;
    z-index: 1;
    overflow: hidden;
    pointer-events: auto;
  }

  .count {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 70px;
    font-weight: 800;
  }

  .count span {
    position: absolute;
    opacity: 0;
  }

  .count span::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120px;
    height: 120px;
    margin: -60px;
    border: 4px solid var(--color-muted);
    border-radius: 50%;
    content: '';
  }

  .film[data-open] .count span {
    animation: count 0.5s calc(1.1s + var(--i) * 0.5s) backwards;
  }

  @keyframes count {
    0% {
      opacity: 0;
    }
    10%,
    90% {
      opacity: 1;
    }
  }

  .video {
    position: absolute;
    inset: 0;
    background: var(--color-night-deep);
  }

  .film[data-open] .video {
    animation: appear 0.1s 2.6s backwards;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  .scene {
    position: absolute;
    inset: 22px 0;
    width: 100%;
    height: calc(100% - 44px);
    object-fit: cover;
  }

  .scene:not(:first-child) {
    opacity: 0;
  }

  /* El clip trae sus dos escenas; las de relleno se turnan cada 4 s. */
  .film[data-open] .scene-placeholder {
    animation: scene-cycle 8s calc(2.6s + var(--i) * 4s) infinite;
  }

  @keyframes scene-cycle {
    0%,
    47% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .progress {
    position: absolute;
    bottom: 6px;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--color-pink);
    transform: scaleX(0);
    transform-origin: 0 0;
  }

  .film[data-open] .progress {
    animation: progress 8s 2.6s linear infinite;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .film-screen .close-x {
    top: 6px;
    right: 6px;
    width: 34px;
    height: 34px;
    border-width: 3px;
    font-size: 15px;
    box-shadow: none;
  }

  /* Entrada de papel sin borde: las muescas junto al talón se recortan con la máscara. */
  .ticket {
    position: absolute;
    top: 854px;
    left: 252px;
    z-index: 1;
    width: 404px;
    margin: 0;
    padding: 9px 16px 11px 44px;
    border-radius: 10px;
    background: #fbf4ff;
    color: var(--color-ink);
    mask:
      radial-gradient(circle 9px at 28px 0, transparent 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle 9px at 28px 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
    rotate: 1.5deg;
  }

  /* talón de la entrada, con el perforado en el color del papel (queda a la derecha al girarlo) */
  .ticket::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: grid;
    width: 28px;
    place-items: center;
    background:
      radial-gradient(circle 2.5px, #fbf4ff 95%, transparent) 0 50% / 6px 13px repeat-y,
      var(--color-pink);
    color: var(--color-wall);
    content: 'ADMIT ONE';
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.2em;
    rotate: 180deg;
    writing-mode: vertical-rl;
  }

  .ticket small {
    color: #9a8ce0;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .ticket b {
    margin-right: 8px;
    color: #4b3a8f;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.05;
  }

  .ticket em {
    color: #6a56b8;
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
  }

  .film[data-open] .ticket {
    animation: rise 0.45s 2.8s backwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cinema[data-active] :global(.screen),
    .cinema[data-active] .beam,
    .cinema[data-active] :global(.lens),
    .cinema :global(:is(.clapper, .clap-lid, .pull, .tug)),
    .dvd,
    .film[data-open] *,
    .film[data-open] .ticket {
      animation: none !important;
    }

    .film .progress {
      display: none;
    }
  }
</style>
