---
/**
 * Repisa de Cine: al llegar, baja el telón y se enciende el proyector. Al elegir una caja, su disco
 * entra al proyector y, tras una cuenta regresiva, la pantalla muestra dos escenas de la película
 * (clips de `public/` o, mientras falten, escenas de relleno) y aparece la entrada.
 */
import { films } from '../../../data/personal';
import { CINE } from './shelf';
import art from './art/cine.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caseX = (k: number) => CINE.x + k * (CINE.w + CINE.gap);
const screenStyle = `left:${CINE.screen.x}px;top:${CINE.screen.y}px;width:${CINE.screen.w}px;height:${CINE.screen.h}px`;
---

<div
  id="cine"
  class="topic cinema pointer-events-none absolute inset-0"
  data-item-detail="cine"
  data-sub-topic="cine"
>
  <svg
    class="absolute inset-0"
    width="1600"
    height="1612"
    viewBox="0 0 1600 1612"
    aria-hidden="true"
  >
    <g set:html={art} />
    <polygon
      class="beam"
      points="1086,1068 1036,882 1036,1108 1086,1086"
      fill="url(#fuera-beam)"
    ></polygon>
  </svg>

  <div class="idle" style={screenStyle} aria-hidden="true">
    <small>FUNCIÓN DE HOY</small>
    <b>← Elige una película</b>
  </div>

  {films.map((f, k) => (
    <a
      href={`#${f.id}`}
      class="sub-object spine case"
      style={`left:${caseX(k)}px;top:${CINE.base - CINE.h}px;width:${CINE.w}px;height:${CINE.h}px;--c:${f.color};--t:${f.textColor ?? '#fff'};--k:${k}`}
      data-sub={f.id}
      aria-controls={f.id}
    >
      <span>{f.title}</span>
    </a>
  ))}

  {films.map((f, k) => {
    // El disco sale de la caja (que sube 24 px) y entra al proyector.
    const cx = caseX(k) + CINE.w / 2;
    const cy = CINE.base - CINE.h - 24 + 30;
    return (
      <>
        <span
          class="dvd"
          style={`left:${cx - 32}px;top:${cy - 32}px;--fx:${CINE.lens.x - cx}px;--fy:${CINE.lens.y - cy}px`}
          aria-hidden="true"
        />
        <article id={f.id} class="sub-detail film" data-sub-detail={f.id} aria-label={f.title}>
          <div class="film-screen" style={screenStyle}>
            <div class="count" aria-hidden="true">
              {['3', '2', '1'].map((n, i) => (
                <span style={`--i:${i}`}>{n}</span>
              ))}
            </div>
            <div class="video">
              {f.scenes.map((color, i) =>
                f.clips[i] ? (
                  <video
                    class="scene"
                    style={`--i:${i}`}
                    src={`${base}${f.clips[i]}`}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  />
                ) : (
                  <div
                    class="scene scene-placeholder"
                    style={`--i:${i};--a:${color};--b:${f.scenes[1 - i]}`}
                    aria-hidden="true"
                  >
                    <b>ESCENA {i + 1}</b>
                    <small>placeholder · clip de {f.title}</small>
                  </div>
                ),
              )}
              <i class="progress" aria-hidden="true" />
            </div>
            <a href="#cine" class="close-x" data-sub-close aria-label={`Detener ${f.title}`}>
              ✕
            </a>
          </div>
          <p class="ticket">
            <small>
              ENTRADA · FUNCIÓN {k + 1} DE {films.length}
            </small>
            <br />
            <b>{f.title}</b>
            <em>
              {f.year} · {f.director}
            </em>
          </p>
        </article>
      </>
    );
  })}
</div>

<style>
  /* El telón está enrollado; al llegar a la repisa baja. */
  .cinema :global(.screen) {
    transform: scaleY(0);
    transform-box: fill-box;
    transform-origin: 50% 0;
  }

  .cinema[data-active] :global(.screen),
  :global(html:not(.js)) .cinema:has(:target) :global(.screen) {
    transform: none;
  }

  .cinema[data-active] :global(.screen) {
    animation: unroll 0.7s cubic-bezier(0.3, 1.2, 0.5, 1) backwards;
  }

  @keyframes unroll {
    from {
      transform: scaleY(0);
    }
  }

  .beam {
    opacity: 0;
  }

  .cinema[data-active] .beam {
    opacity: 1;
    animation:
      flicker 0.25s 0.7s steps(2) backwards,
      flicker-idle 3s 1.2s infinite;
  }

  @keyframes flicker {
    from {
      opacity: 0;
    }
  }

  @keyframes flicker-idle {
    50% {
      opacity: 0.82;
    }
  }

  .cinema[data-active] :global(.lens) {
    animation: glow 1s 0.6s infinite alternate;
  }

  @keyframes glow {
    to {
      fill: #fff;
    }
  }

  .idle {
    position: absolute;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .idle small {
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.3em;
  }

  .idle b {
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.05;
  }

  .cinema[data-active]:not([data-open]) .idle {
    opacity: 1;
    transition-delay: 1s;
  }

  .case {
    padding: 26px 0 30px;
    font-size: 12px;
  }

  /* el disco que asoma de la caja */
  .case::after {
    position: absolute;
    bottom: 8px;
    left: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border: 2px solid var(--color-plum);
    border-radius: 50%;
    background: radial-gradient(var(--c) 0 25%, #e8e6f0 26%);
    content: '';
  }

  .case[aria-current] {
    translate: 0 -24px;
  }

  .dvd {
    position: absolute;
    z-index: 2;
    width: 64px;
    height: 64px;
    border: 3px solid var(--color-plum);
    border-radius: 50%;
    background:
      radial-gradient(#fffdf7 0 13%, var(--color-plum) 14% 18%, transparent 19%),
      conic-gradient(#c6e6ff, #ffc6e6, #fff3b0, #c6ffe9, #c6e6ff);
    opacity: 0;
    pointer-events: none;
  }

  .dvd:has(+ .film[data-open]) {
    animation: dvd-in 0.85s 0.3s cubic-bezier(0.4, 0, 0.3, 1) backwards;
  }

  @keyframes dvd-in {
    0% {
      opacity: 1;
      scale: 0.7;
    }
    55% {
      opacity: 1;
      translate: calc(var(--fx) * 0.55) calc(var(--fy) * 0.55 - 150px);
      scale: 1.1;
    }
    90% {
      opacity: 1;
      scale: 0.55;
    }
    100% {
      opacity: 0;
      translate: var(--fx) var(--fy);
      rotate: 900deg;
      scale: 0.4;
    }
  }

  .film {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .film-screen {
    position: absolute;
    z-index: 1;
    overflow: hidden;
    pointer-events: auto;
  }

  .count {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 70px;
    font-weight: 800;
  }

  .count span {
    position: absolute;
    opacity: 0;
  }

  .count span::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120px;
    height: 120px;
    margin: -60px;
    border: 4px solid var(--color-muted);
    border-radius: 50%;
    content: '';
  }

  .film[data-open] .count span {
    animation: count 0.5s calc(1.1s + var(--i) * 0.5s) backwards;
  }

  @keyframes count {
    0% {
      opacity: 0;
    }
    10%,
    90% {
      opacity: 1;
    }
  }

  .video {
    position: absolute;
    inset: 0;
    background: var(--color-night-deep);
  }

  .film[data-open] .video {
    animation: appear 0.1s 2.6s backwards;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  .scene {
    position: absolute;
    inset: 22px 0;
    width: 100%;
    height: calc(100% - 44px);
    object-fit: cover;
  }

  .scene:not(:first-child) {
    opacity: 0;
  }

  .film[data-open] .scene {
    animation: scene-cycle 8s calc(2.6s + var(--i) * 4s) infinite;
  }

  @keyframes scene-cycle {
    0%,
    47% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .progress {
    position: absolute;
    bottom: 6px;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--color-pink);
    transform: scaleX(0);
    transform-origin: 0 0;
  }

  .film[data-open] .progress {
    animation: progress 8s 2.6s linear infinite;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .film-screen .close-x {
    top: 6px;
    right: 6px;
    width: 34px;
    height: 34px;
    border-width: 3px;
    font-size: 15px;
    box-shadow: none;
  }

  .ticket {
    position: absolute;
    top: 856px;
    left: 252px;
    z-index: 1;
    width: 404px;
    margin: 0;
    padding: 9px 16px 11px 38px;
    border: 3px solid var(--color-plum);
    border-radius: 8px;
    background: #fff8e7;
    box-shadow: 4px 5px 0 var(--color-plum);
    color: var(--color-ink);
    rotate: -1.5deg;
  }

  /* talón de la entrada */
  .ticket::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: grid;
    width: 24px;
    place-items: center;
    border-right: 3px dashed var(--color-plum);
    border-radius: 0 6px 6px 0;
    background: var(--color-sun);
    color: var(--color-plum);
    content: 'ADMIT ONE';
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.2em;
    rotate: 180deg;
    writing-mode: vertical-rl;
  }

  .ticket small {
    color: var(--color-muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .ticket b {
    margin-right: 8px;
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.05;
  }

  .ticket em {
    color: var(--color-muted);
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
  }

  .film[data-open] .ticket {
    animation: rise 0.45s 2.8s backwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cinema[data-active] :global(.screen),
    .cinema[data-active] .beam,
    .cinema[data-active] :global(.lens),
    .dvd,
    .film[data-open] *,
    .film[data-open] .ticket {
      animation: none !important;
    }

    .film .progress {
      display: none;
    }
  }
</style>
