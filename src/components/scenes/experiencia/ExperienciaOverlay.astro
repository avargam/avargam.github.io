---
/**
 * Capa HTML de Experiencia (escala 1:1 sobre la escena): Volver, placa del título, chips de ítems
 * y pista. El detalle vive en el corcho (hilos y `Postcard`); la cámara no se mueve.
 */
import { getSection } from '../../../data/sections';
import SectionShell from '../../ui/SectionShell.astro';
import ItemChips from '../../ui/ItemChips.astro';
import { experienciaItems } from './board';

interface Props {
  active: boolean;
}

const { active } = Astro.props;
---

<SectionShell
  section={getSection('experiencia')}
  active={active}
  hideTitle
  hint="Elige una nota · ← → recorrer · Esc quitar"
  touchHint="Toca una nota · desliza para recorrer"
>
  <div class="plate shell-enter" style="--i: 1" aria-hidden="true" data-plate>
    Experiencia
    <span class="plate-pin"></span>
  </div>
  <ItemChips slot="chips" items={experienciaItems} label="Experiencia" />
</SectionShell>

<script>
  import { createItemNav } from '../../stage/itemNav';
  import { panToSceneRect, registerSection } from '../../stage/router';
  import { prefersReducedMotion } from '../../stage/camera';
  import { POSTCARD_TEXT, experienciaItem, experienciaItems, threadTime } from './board';
  import type { JobId } from '../../../data/experience';

  const nav = createItemNav({
    slug: 'experiencia',
    ids: experienciaItems.map((i) => i.id),
    describe: (id) => experienciaItem(id)?.name ?? '',
    /**
     * La postal llega cuando el hilo (animado con CSS) termina de tenderse. En el teléfono, la
     * cámara va mientras tanto a la mitad del texto de la postal (o a la fila de Skills).
     */
    focus(id, instant) {
      if (!id) return Promise.resolve(true);
      const item = experienciaItem(id);
      void panToSceneRect(
        'experiencia',
        id === 'skills' && item ? item.hit : POSTCARD_TEXT,
        instant,
      );
      if (id === 'skills' || instant || prefersReducedMotion()) return Promise.resolve(true);
      return new Promise((resolve) => setTimeout(() => resolve(true), threadTime(id as JobId)));
    },
  });
  if (nav) registerSection('experiencia', nav);
</script>

<style>
  .plate {
    position: absolute;
    top: 58px;
    left: 316px;
    display: grid;
    width: 300px;
    height: 62px;
    border: 4px solid var(--color-plum);
    border-radius: 12px;
    background: var(--color-wall);
    box-shadow: 6px 8px 0 var(--color-plum);
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 800;
    place-items: center;
  }

  .plate-pin {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 18px;
    height: 18px;
    border: 3px solid var(--color-plum);
    border-radius: 50%;
    background: var(--color-pink);
  }
</style>
