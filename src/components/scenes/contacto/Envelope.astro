---
/**
 * Correo: un sobre cerrado con lacre y la dirección al frente. Al abrirlo, la solapa gira, el frente
 * da paso al bolsillo y la carta asoma desde adentro con "Escribir" (`mailto:`) y "Copiar
 * dirección"; copiar estampa "¡COPIADO!" en la carta. Los stickers se pegan al frente (cerrado) o
 * a la carta y el bolsillo (abierto), en su `[data-surface]`.
 */
import { profile } from '../../../data/profile';
import { contact } from '../../../data/contact';
import { HOME, spotStyle } from './desk';

interface Props {
  z: number;
}

const item = contact('correo')!;
const [line1, line2] = profile.tagline.split(', ');
---

<div
  id="correo"
  class="desk-obj envelope"
  style={spotStyle(HOME.correo, Astro.props.z)}
  data-desk-obj="correo"
>
  <a
    href="#correo"
    class="desk-hit"
    data-desk-hit="correo"
    aria-expanded="false"
    aria-label={item.name}
  ></a>
  <div class="paper"></div>
  <section class="letter" aria-label="Carta">
    <p class="hand">Escríbeme a:</p>
    <p class="mail">{profile.email}</p>
    <svg width="380" height="14" viewBox="0 0 380 14" aria-hidden="true">
      <path
        d="M4 9 q120 -10 240 0 t130 0"
        fill="none"
        stroke="var(--color-pink)"
        stroke-width="5"
        stroke-linecap="round"
      ></path>
    </svg>
    <p class="line">
      {line1},<br />
      {line2}.
    </p>
    <div class="acts">
      <a class="desk-btn pink" href={item.href}>
        ✉ Escribir
      </a>
      <button type="button" class="desk-btn" data-copy-email>
        Copiar dirección
      </button>
    </div>
    <p class="copied" aria-hidden="true">
      ¡COPIADO!
    </p>
    <div class="stuck" data-surface="carta"></div>
  </section>
  <svg class="pocket" width="570" height="400" viewBox="0 0 570 400" aria-hidden="true">
    <path
      d="M0 152L285 266L570 152V388Q570 400 558 400H12Q0 400 0 388Z"
      fill="var(--color-paper)"
    ></path>
    <path d="M0 152L218 240L0 400Z" fill="#fbe9d6"></path>
    <path d="M570 152L352 240L570 400Z" fill="#fbe9d6"></path>
  </svg>
  <!-- Abierto, lo que queda bajo la carta: el bolsillo. -->
  <div class="stuck pocket-stuck" style="top: 150px" data-surface="bolsillo"></div>
  <svg class="front" width="570" height="400" viewBox="0 0 570 400" aria-hidden="true">
    <rect width="570" height="400" rx="12" fill="var(--color-paper)"></rect>
    <text x="56" y="300" class="to">
      PARA
    </text>
    <text x="56" y="350" class="address">
      {profile.email}
    </text>
    <path
      d="M56 366q95-10 190 0t150 0"
      fill="none"
      stroke="var(--color-pink)"
      stroke-width="7"
      stroke-linecap="round"
    ></path>
  </svg>
  <div class="flap" aria-hidden="true">
    <svg class="out" width="570" height="214" viewBox="0 0 570 214">
      <polygon points="10,5 285,214 560,5" fill="#ffe4ec"></polygon>
      <polygon points="10,5 285,214 285,176 52,5" fill="#ffd3e2"></polygon>
      <circle cx="285" cy="200" r="43" fill="var(--color-hotpink)"></circle>
      <circle cx="285" cy="200" r="26" fill="none" stroke="#ff9cc8" stroke-width="6"></circle>
      <!-- La estampilla va en la esquina del sobre, sobre la solapa: se va con ella al abrir. -->
      <rect x="461" y="33" width="76" height="90" rx="5" fill="#fbf4ff"></rect>
      <rect x="468" y="40" width="62" height="76" rx="2" fill="var(--color-mint)"></rect>
      <circle cx="499" cy="78" r="14" fill="#fbf4ff" opacity=".7"></circle>
    </svg>
    <svg class="in" width="570" height="214" viewBox="0 0 570 214">
      <polygon points="10,209 285,4 560,209" fill="#f7d3df"></polygon>
    </svg>
  </div>
  <div class="stuck front-stuck" data-surface="correo"></div>
</div>

<style>
  .envelope {
    width: 570px;
    height: 400px;
  }

  /*
   * Por capas: el interior (`.paper`), la carta, el bolsillo y el frente opaco, que tapa todo lo de
   * adentro con el sobre cerrado. Al abrir, el frente se desvanece, la solapa gira y la carta sube;
   * al cerrar, al revés: primero baja la carta y, ya guardada, vuelven el frente y la solapa.
   */
  .paper {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: #f2d6c0;
    box-shadow: var(--sh, 8px 10px 0) var(--shadow);
    transition: box-shadow 0.15s;
  }

  .front,
  .pocket {
    position: absolute;
    inset: 0;
  }

  .front {
    z-index: 3;
    transition: opacity 0.15s 0.4s;
  }

  .pocket {
    z-index: 2;
    opacity: 0;
    transition: opacity 0s 0.55s;
  }

  .envelope:is([data-open], :global(html:not(.js)) :target) .front {
    opacity: 0;
    transition: opacity 0.15s;
  }

  .envelope:is([data-open], :global(html:not(.js)) :target) .pocket {
    opacity: 1;
    transition: opacity 0.15s;
  }

  .to {
    fill: var(--color-violet);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .address {
    fill: var(--color-plum);
    font-family: var(--font-display);
    font-size: 50px;
    font-weight: 800;
  }

  /* La solapa gira sobre el borde de arriba; abierta, queda detrás de la carta. */
  .flap {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 4;
    width: 570px;
    height: 214px;
    transform: perspective(1600px) rotateX(0deg);
    transform-origin: 50% 0;
    transform-style: preserve-3d;
    /* Se cierra cuando la carta ya bajó; pasa adelante de ella al quedar vertical. */
    transition:
      transform 0.45s cubic-bezier(0.5, 0, 0.3, 1) 0.4s,
      z-index 0s 0.62s;
  }

  .flap svg {
    position: absolute;
    inset: 0;
    overflow: visible;
    backface-visibility: hidden;
  }

  .flap .in {
    transform: rotateX(180deg);
  }

  .envelope:is([data-open], :global(html:not(.js)) :target) .flap {
    z-index: 0;
    transform: perspective(1600px) rotateX(180deg);
    transition:
      transform 0.45s cubic-bezier(0.5, 0, 0.3, 1),
      z-index 0s 0.22s;
  }

  /* Entre el interior y el bolsillo: abierta, sube y su borde de abajo queda dentro del sobre. */
  .letter {
    position: absolute;
    top: 30px;
    left: 60px;
    z-index: 1;
    width: 450px;
    height: 360px;
    padding: 22px 34px;
    border-radius: 8px;
    background: #fffdf7;
    color: var(--color-plum);
    /* Guardada no se ve ni recibe clics o foco (el papel del sobre no la tapa para el puntero). */
    visibility: hidden;
    /* Al guardarla, sin rebote (no asoma por debajo del sobre); se oculta cuando vuelve el frente. */
    transition:
      translate 0.4s cubic-bezier(0.5, 0, 0.7, 1),
      visibility 0s 0.4s;
  }

  .envelope:is([data-open], :global(html:not(.js)) :target) .letter {
    visibility: visible;
    /* Aparece cuando el frente ya se fue y sube. */
    transition:
      translate 0.5s cubic-bezier(0.3, 1.2, 0.5, 1) 0.35s,
      visibility 0s 0.15s;
    translate: 0 -240px;
  }

  .letter p {
    margin: 0;
  }

  .hand {
    color: var(--color-muted);
    font-family: var(--font-hand);
    font-size: 34px;
    font-weight: 700;
  }

  .mail {
    margin-top: 2px;
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .letter svg {
    display: block;
    margin: 2px 0 6px;
  }

  .line {
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
  }

  .acts {
    display: flex;
    margin-top: 16px;
    gap: 12px;
  }

  .copied {
    position: absolute;
    top: 150px;
    right: 18px;
    padding: 4px 14px;
    border: 5px solid var(--color-hotpink);
    border-radius: 10px;
    color: var(--color-hotpink);
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 0.04em;
    mix-blend-mode: multiply;
    opacity: 0;
    pointer-events: none;
    rotate: -12deg;
  }

  .copied:global([data-on]) {
    animation: stamp 0.45s cubic-bezier(0.3, 1.5, 0.5, 1) forwards;
  }

  @keyframes stamp {
    0% {
      opacity: 0;
      scale: 2.2;
    }
    60% {
      opacity: 0.95;
      scale: 0.92;
    }
    100% {
      opacity: 0.9;
      scale: 1;
    }
  }

  /* Los del frente van sobre todo el sobre cerrado y se van con el frente al abrirlo; los del
     bolsillo, al revés. */
  .front-stuck {
    z-index: 5;
    transition:
      opacity 0.15s 0.4s,
      visibility 0s 0.4s;
  }

  .pocket-stuck {
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0s 0.55s,
      visibility 0s 0.55s;
  }

  .envelope:is([data-open], :global(html:not(.js)) :target) .front-stuck {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.15s,
      visibility 0s 0.15s;
  }

  .envelope:is([data-open], :global(html:not(.js)) :target) .pocket-stuck {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.15s;
  }

  @media (prefers-reduced-motion: reduce) {
    .envelope :is(.paper, .front, .pocket, .front-stuck, .pocket-stuck, .flap, .letter) {
      transition: none !important;
    }

    .copied:global([data-on]) {
      animation: none;
      opacity: 0.9;
    }
  }
</style>
