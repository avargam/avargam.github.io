---
/**
 * Escena de Contacto: la mesa del escritorio vista desde arriba, con un objeto por canal (sobre,
 * paquete, tarjetero, carpeta) y cosas sueltas (bolígrafo, hoja de stickers). Todo se arrastra;
 * un clic abre el objeto (`deskClient.ts`). Va sobre la cámara a 1:1 y entra inclinada (router);
 * en pantallas táctiles, la mesa tiene su propia escala y se recorre con el dedo.
 *
 * Cada objeto es un `.desk-obj` posicionado con --x, --y y --r. Su `.desk-hit` (un ancla #id, al
 * fondo) recibe el puntero y el teclado: el dibujo encima no captura clics, salvo enlaces y botones.
 * Como en el resto del cuarto, nada lleva contorno: el volumen sale de los tonos y la sombra suave.
 */
import Envelope from './Envelope.astro';
import Parcel from './Parcel.astro';
import CardHolder from './CardHolder.astro';
import CvFolder from './CvFolder.astro';
import {
  HOME,
  LOOT,
  PEELED,
  SHEET,
  STICKER_KINDS,
  slotSpot,
  spotStyle,
  type StickerKind,
} from './desk';
import pato from './art/pato.svg?raw';
import enter from './art/enter.svg?raw';
import pendrive from './art/pendrive.svg?raw';
import boligrafo from './art/boligrafo.svg?raw';

const stickerArt = import.meta.glob<string>('./art/stickers/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const art = (kind: StickerKind) => stickerArt[`./art/stickers/${kind}.svg`];
/** Troquelado: sombra y borde blanco (copias del dibujo con trazo grueso, por CSS) y el dibujo. */
const stickerSvg = (kind: StickerKind) =>
  `<g class="cut sh">${art(kind)}</g><g class="cut">${art(kind)}</g>${art(kind)}`;

const loot = LOOT.map((l) => ({ ...l, x: HOME.github.x + l.dx, y: HOME.github.y + l.dy }));
const lootArt = {
  pato: { svg: pato, w: 120, h: 110, box: '0 0 120 110' },
  enter: { svg: enter, w: 90, h: 108, box: '0 0 90 108' },
  pendrive: { svg: pendrive, w: 44, h: 116, box: '0 -24 44 116' },
};
const sticker = STICKER_KINDS.map((kind, i) => ({ kind, i, peeled: PEELED[kind] }));
---

<div class="desk absolute inset-0" data-desk>
  <svg
    class="absolute inset-0"
    width="1600"
    height="1000"
    viewBox="0 0 1600 1000"
    aria-hidden="true"
  >
    {Array.from({ length: 8 }, (_, i) => (
      <>
        <rect x={i * 200} width="200" height="1000" fill={i % 2 ? '#8a51a0' : '#8e55a3'} />
        <rect x={i * 200} width="6" height="1000" fill="var(--color-desk)" />
      </>
    ))}
    <path
      d="M300 60q-14 120 0 240t0 240M900 520q-14 120 0 240t0 200M1100 40q-12 100 0 200M500 700q-12 100 0 220"
      fill="none"
      stroke="var(--color-desk)"
      stroke-width="3"
      stroke-linecap="round"
      opacity=".5"
    ></path>
    <ellipse cx="1300" cy="640" rx="22" ry="40" fill="var(--color-desk)" opacity=".55"></ellipse>
    <ellipse cx="1300" cy="640" rx="9" ry="20" fill="#8e55a3"></ellipse>
    <ellipse cx="80" cy="380" rx="18" ry="34" fill="var(--color-desk)" opacity=".55"></ellipse>
    <ellipse cx="80" cy="380" rx="7" ry="16" fill="#8a51a0"></ellipse>
    <!-- La luz de la lámpara que en el cuarto está junto a la mesa. -->
    <g fill="var(--color-sun)" opacity=".04">
      {[980, 820, 660, 500, 340].map((r) => (
        <circle cx="1600" cy="0" r={r} />
      ))}
    </g>
  </svg>

  <div class="desk-obj boligrafo" style={spotStyle(HOME.boligrafo, 1)} aria-hidden="true">
    <svg width="380" height="47" viewBox="0 -8 290 36" set:html={boligrafo} />
  </div>

  <Parcel z={2} />
  <CvFolder z={3} />
  <Envelope z={4} />
  <CardHolder z={6} />

  <div class="desk-obj sheet" style={spotStyle(SHEET.spot, 9)} data-desk-sheet aria-hidden="true">
    <p class="sheet-title">STICKERS</p>
    {sticker.map(({ i, peeled }) => {
      const s = slotSpot(i);
      const pad = 6 - (SHEET.size - SHEET.cell) / 2;
      return (
        <i
          class="slot"
          data-sheet-slot={i}
          data-empty={peeled ? '' : undefined}
          style={`left:${s.x + pad}px;top:${s.y + pad}px;width:${SHEET.cell - 12}px;height:${SHEET.cell - 12}px`}
        />
      );
    })}
    {sticker
      .filter((s) => !s.peeled)
      .map(({ kind, i }) => (
        <div
          class="desk-obj sticker"
          style={spotStyle(slotSpot(i), 1)}
          data-desk-sticker={kind}
          data-slot={i}
          data-on-sheet
        >
          <svg width="78" height="78" viewBox="0 0 240 240" set:html={stickerSvg(kind)} />
        </div>
      ))}
  </div>
  {sticker
    .filter((s) => s.peeled)
    .map(({ kind, i, peeled }) => (
      <div
        class="desk-obj sticker"
        style={spotStyle(peeled!, 10 + i)}
        data-desk-sticker={kind}
        data-slot={i}
        aria-hidden="true"
      >
        <svg width="78" height="78" viewBox="0 0 240 240" set:html={stickerSvg(kind)} />
      </div>
    ))}

  <!-- Lo que trae el paquete: no se ve hasta abrirlo. -->
  {loot.map((l, i) => (
    <div
      class:list={['desk-obj loot', l.id]}
      style={spotStyle(l, 20 + i)}
      data-loot={l.id}
      data-dx={l.dx}
      data-dy={l.dy}
      aria-hidden="true"
    >
      <svg
        width={lootArt[l.id].w}
        height={lootArt[l.id].h}
        viewBox={lootArt[l.id].box}
        set:html={lootArt[l.id].svg}
      />
      {l.id === 'pato' && <span class="quack">¡Cuac!</span>}
    </div>
  ))}
</div>

<style>
  .desk {
    --shadow: rgb(42 27 107 / 0.2);
    overflow: clip;
    background: #8e55a3;
  }

  /* ---------- objetos (comunes) ---------- */
  .desk :global(.desk-obj) {
    position: absolute;
    top: 0;
    left: 0;
    cursor: grab;
    rotate: var(--r);
    touch-action: none;
    transition: scale 0.15s;
    translate: var(--x) var(--y);
    user-select: none;
    -webkit-user-select: none;
  }

  /* El dibujo no captura el puntero: lo recibe el ancla del fondo, o el objeto entero si no tiene.
     Con :where(), un objeto puede devolverle el puntero a una parte (la pestaña de la carpeta). */
  .desk :global(:where(.desk-obj:has(.desk-hit) > :not(.desk-hit))) {
    pointer-events: none;
  }

  .desk :global(.desk-obj :is(a, button):not(.desk-hit)) {
    pointer-events: auto;
  }

  /* Superficies donde se pegan los stickers (sobre, tapas, tarjetero, tarjeta): cubren su parte
     del objeto y no capturan el puntero, pero lo pegado se puede volver a despegar. */
  .desk :global([data-surface]) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .desk :global([data-surface] > .desk-obj) {
    pointer-events: auto;
  }

  .desk :global(.desk-hit) {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    cursor: inherit;
  }

  .desk :global(.desk-hit:focus-visible) {
    outline: 4px dashed var(--color-sun);
    outline-offset: 8px;
  }

  /* Levantado al arrastrar: un poco más grande y con la sombra más lejos. */
  .desk :global(.desk-obj[data-lifted]) {
    --sh: 18px 24px 0;
    cursor: grabbing;
    scale: 1.04;
  }

  .desk :global(.desk-obj[data-settle]) {
    transition:
      translate 0.55s cubic-bezier(0.3, 1.2, 0.5, 1),
      rotate 0.55s,
      scale 0.15s;
  }

  .desk :global(.desk-obj[data-drop]) {
    animation: drop 0.25s ease-out;
  }

  @keyframes drop {
    0% {
      scale: 1.04;
    }
    60% {
      scale: 0.985;
    }
  }

  .desk :global(.desk-obj svg) {
    display: block;
    overflow: visible;
  }

  /* Los dibujos sueltos (sin caja) llevan la sombra como filtro, sin desenfoque. */
  .boligrafo svg,
  .loot svg {
    filter: drop-shadow(var(--sh, 6px 8px 0) var(--shadow));
  }

  .desk :global(.desk-btn) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--color-wall);
    box-shadow: 0 4px 0 var(--shadow);
    color: var(--color-plum);
    cursor: pointer;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
  }

  /* Tinta sobre rosa, como en Proyectos: el blanco no llega al contraste mínimo. */
  .desk :global(.desk-btn.pink) {
    background: var(--color-pink);
    color: var(--color-ink);
  }

  .desk :global(.desk-btn:is(:hover, :focus-visible)) {
    background: var(--color-sun);
    color: var(--color-plum);
    outline: none;
  }

  .desk :global(.desk-btn:active) {
    box-shadow: 0 2px 0 var(--shadow);
    translate: 0 2px;
  }

  .boligrafo {
    width: 380px;
    height: 47px;
  }

  /* ---------- hoja de stickers ---------- */
  .sheet {
    width: 300px;
    height: 250px;
    border-radius: 16px;
    background: #fbf4ff;
    box-shadow: var(--sh, 6px 8px 0) var(--shadow);
    transition:
      scale 0.15s,
      box-shadow 0.15s;
  }

  .sheet-title {
    position: absolute;
    top: 14px;
    left: 20px;
    margin: 0;
    color: #9a8ce0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.24em;
  }

  /* El hueco que deja cada sticker despegado (`deskClient.ts` marca los vacíos). */
  .slot {
    position: absolute;
    border: 2px dashed #dad0ff;
    border-radius: 12px;
    visibility: hidden;
  }

  .slot:global([data-empty]) {
    visibility: visible;
  }

  .sticker {
    width: 78px;
    height: 78px;
  }

  /* Troquelado: copias del dibujo con relleno y trazo grueso (el CSS gana a los atributos). */
  .sticker :global(.cut *) {
    fill: #fff;
    stroke: #fff;
    stroke-linejoin: round;
    stroke-width: 34px;
  }

  .sticker :global(.cut .ln) {
    stroke-width: 44px;
  }

  .sticker :global(.cut.sh) {
    opacity: 0.16;
    translate: 0 18px;
  }

  .sticker :global(.cut.sh *) {
    fill: #2a1b6b;
    stroke: #2a1b6b;
  }

  /* Más lejos al levantarlo, como la sombra de los demás objetos. */
  .desk :global(.sticker[data-lifted] .cut.sh) {
    translate: 12px 40px;
  }

  .sticker svg {
    transition: scale 0.2s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  /* En la hoja: más chico y sin sombra; al despegarlo crece a su tamaño. */
  .desk :global(.sticker[data-on-sheet] svg) {
    scale: 0.72;
  }

  .desk :global(.sticker[data-on-sheet] .cut.sh) {
    opacity: 0;
  }

  .desk :global(.sticker[data-stuck]) {
    animation: stick 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  @keyframes stick {
    0% {
      scale: 1.3;
    }
  }

  /* ---------- lo que trae el paquete ---------- */
  .loot {
    display: none;
  }

  .loot:global([data-out]) {
    display: block;
  }

  /* Salta desde el paquete (--fx, --fy) hasta su lugar. */
  .loot:global([data-jump]) {
    animation: jump 0.8s cubic-bezier(0.3, 0, 0.5, 1);
  }

  @keyframes jump {
    0% {
      scale: 0.3;
      translate: var(--fx) var(--fy);
    }
    55% {
      scale: 1.15;
      translate: calc((var(--fx) + var(--x)) / 2) calc(min(var(--fy), var(--y)) - 160px);
    }
  }

  .loot:global([data-store]) {
    scale: 0.3;
    transition:
      translate 0.35s cubic-bezier(0.5, 0, 0.8, 0.5),
      scale 0.35s cubic-bezier(0.5, 0, 0.8, 0.5);
  }

  .pato {
    width: 120px;
    height: 110px;
  }

  .pato:global([data-quack]) svg {
    animation: squish 0.35s;
  }

  @keyframes squish {
    30% {
      scale: 1.12 0.9;
    }
    60% {
      scale: 0.95 1.08;
    }
  }

  .quack {
    position: absolute;
    top: -46px;
    left: 92px;
    padding: 6px 14px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 4px 0 var(--shadow);
    color: var(--color-plum);
    font-size: 18px;
    font-weight: 800;
    opacity: 0;
    rotate: calc(var(--r) * -1);
    transition:
      opacity 0.2s,
      translate 0.2s;
    translate: 0 6px;
    white-space: nowrap;
  }

  .pato:global([data-quack]) .quack {
    opacity: 1;
    translate: 0 0;
  }

  .enter {
    width: 90px;
    height: 108px;
  }

  .pendrive {
    width: 44px;
    height: 92px;
  }

  .pendrive svg {
    margin-top: -24px;
  }

  /* ---------- pellets ---------- */
  /* Lanzado: lo mueve el script cuadro a cuadro, sin transiciones. */
  .desk :global(.pellet[data-flying]) {
    pointer-events: none;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .desk :global(.desk-obj),
    .desk :global(.desk-obj[data-settle]),
    .loot:global([data-store]),
    .quack,
    .sticker svg {
      transition: none;
    }

    .desk :global(.desk-obj[data-drop]),
    .desk :global(.sticker[data-stuck]),
    .loot:global([data-jump]),
    .pato:global([data-quack]) svg {
      animation: none;
    }
  }
</style>
