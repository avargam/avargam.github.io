---
/**
 * Contacto: la mesa (escena `tilt`, que el router hace entrar inclinada sobre las miniaturas del
 * cuarto) y su capa HTML: Volver, Ordenar, chips 1–4 y pista (sin placa: el título solo lo leen los
 * lectores de pantalla, como en Experiencia). La lógica de la mesa está en `deskClient.ts`.
 */
import { getSection } from '../../../data/sections';
import SectionShell from '../../ui/SectionShell.astro';
import ItemChips from '../../ui/ItemChips.astro';
import DeskScene from './DeskScene.astro';
import { contactoItems } from './desk';

interface Props {
  active: boolean;
}

const { active } = Astro.props;
---

<div
  class="absolute inset-0"
  data-scene="contacto"
  data-tilt-scene="contacto"
  hidden={!active}
  inert={!active}
>
  <DeskScene />
</div>

<SectionShell
  section={getSection('contacto')}
  active={active}
  hideTitle
  hintTone="light"
  hint="Arrastra las cosas · clic o 1–4 para abrir · C copia el correo · Esc cerrar"
  touchHint="Arrastra las cosas · toca para abrir · desliza la mesa"
>
  <button
    type="button"
    class="tidy shell-enter pointer-events-auto"
    style="--i: 1"
    data-desk-tidy
    data-screen="top-right"
  >
    ↺ Ordenar<span class="long"> la mesa</span>
  </button>
  <ItemChips slot="chips" items={contactoItems} label="Contacto" />
</SectionShell>

<script>
  import { registerSection } from '../../stage/router';
  import { initDesk } from './deskClient';

  const root = document.querySelector<HTMLElement>('[data-desk]');
  const overlay = document.querySelector<HTMLElement>('[data-overlay="contacto"]');
  if (root && overlay) registerSection('contacto', initDesk(root, overlay));
</script>

<style>
  .tidy {
    position: absolute;
    top: 56px;
    right: 40px;
    height: 52px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: var(--color-wall);
    box-shadow: 0 6px 0 rgb(43 45 66 / 0.25);
    color: var(--color-plum);
    cursor: pointer;
    font-size: 18px;
    font-weight: 700;
  }

  .tidy:is(:hover, :focus-visible) {
    background: var(--color-sun);
    outline: none;
  }

  /* En el teléfono va junto a Volver: más corto. */
  :global(html.touch) .tidy {
    height: auto;
    padding: 8px 14px;
    font-size: 16px;
  }

  :global(html.touch) .tidy .long {
    display: none;
  }

  /* Sin JS no se puede arrastrar: no hay nada que ordenar. */
  :global(html:not(.js)) .tidy {
    display: none;
  }

  /* En el teléfono, la mesa toma su color más allá del dibujo (se ve más que el escenario). */
  :global(html.touch) [data-tilt-scene] {
    background: #8e55a3;
  }
</style>
