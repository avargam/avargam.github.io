---
/** CV: una carpeta. Al abrirla, la tapa se da vuelta hacia la derecha y adentro está la hoja con el PDF. */
import { profile } from '../../../data/profile';
import { contact } from '../../../data/contact';
import { HOME, spotStyle } from './desk';

interface Props {
  z: number;
}

const item = contact('cv')!;
const [first, second] = profile.name.split(' ');
/** Largo de las líneas de cada sección de la hoja en miniatura (en %). */
const sections = [
  { title: 'PERFIL', lines: [100, 100, 70] },
  { title: 'EXPERIENCIA', lines: [100, 85, 100, 60] },
  { title: 'HABILIDADES', lines: [90, 75] },
];
---

<div id="cv" class="desk-obj folder" style={spotStyle(HOME.cv, Astro.props.z)} data-desk-obj="cv">
  <a
    href="#cv"
    class="desk-hit"
    data-desk-hit="cv"
    aria-expanded="false"
    aria-label={item.name}
  ></a>
  <div class="tab" aria-hidden="true">
    CV
  </div>
  <div class="body" aria-hidden="true"></div>
  <section class="sheet" aria-label="Currículum">
    <p class="name">{profile.name}</p>
    <p class="sub">{profile.role}</p>
    {sections.map((s) => (
      <div aria-hidden="true">
        <p class="sec">{s.title}</p>
        {s.lines.map((w) => (
          <i style={`width:${w}%`}></i>
        ))}
      </div>
    ))}
    <div class="acts">
      <a class="desk-btn pink" href={item.href} download="AlonsoVargas_CV.pdf">
        Descargar PDF ↓
      </a>
      <a class="desk-btn" href={item.href} target="_blank" rel="noopener">
        Ver en otra pestaña ↗
      </a>
    </div>
  </section>
  <div class="cover" aria-hidden="true">
    <div class="face">
      <small>CURRÍCULUM</small>
      <b>
        {first} {second} M.
      </b>
      <span>PDF ↓</span>
    </div>
    <div class="rev"></div>
  </div>
</div>

<style>
  .folder {
    width: 270px;
    height: 350px;
  }

  .tab {
    position: absolute;
    top: -30px;
    left: 0;
    display: grid;
    width: 110px;
    height: 44px;
    padding-top: 4px;
    border: 4px solid var(--color-plum);
    border-radius: 9px 9px 0 0;
    background: #e9c35e;
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    place-items: start center;
  }

  /* Asoma fuera del ancla: también sirve para agarrar la carpeta. */
  .folder .tab {
    pointer-events: auto;
  }

  .body {
    position: absolute;
    inset: 0;
    border: 5px solid var(--color-plum);
    border-radius: 4px 10px 10px;
    background: #e9c35e;
    box-shadow: var(--sh, 8px 10px 0) var(--shadow);
    transition: box-shadow 0.15s;
  }

  .sheet {
    position: absolute;
    top: 12px;
    left: 14px;
    width: 242px;
    height: 326px;
    overflow: hidden;
    padding: 16px;
    border: 3px solid var(--color-plum);
    border-radius: 3px;
    background: #fffdf7;
    color: var(--color-ink);
    /* Cerrada, los enlaces de la hoja no reciben clics ni foco. */
    visibility: hidden;
    transition: visibility 0s 0.6s;
  }

  .folder:is([data-open], :global(html:not(.js)) :target) .sheet {
    visibility: visible;
    transition: none;
  }

  .name {
    margin: 0;
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    text-align: center;
  }

  .sub {
    margin: 0 0 4px;
    color: var(--color-muted);
    font-size: 9px;
    text-align: center;
  }

  .sec {
    margin: 8px 0 4px;
    border-bottom: 1.5px solid var(--color-plum);
    color: var(--color-plum);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .sheet i {
    display: block;
    height: 4px;
    margin: 3px 0;
    border-radius: 2px;
    background: #d9c9ef;
  }

  .acts {
    position: absolute;
    right: 0;
    bottom: 14px;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .acts .desk-btn {
    padding: 6px 14px;
    font-size: 14px;
  }

  /* La tapa se abre como un libro hacia la derecha. */
  .cover {
    position: absolute;
    inset: 0;
    z-index: 3;
    transform-origin: 100% 50%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.5, 0, 0.3, 1);
  }

  .cover > div {
    position: absolute;
    inset: 0;
    border: 5px solid var(--color-plum);
    border-radius: 4px 10px 10px;
    backface-visibility: hidden;
  }

  .face {
    padding: 120px 26px 0;
    background: #f3d37a;
    color: var(--color-plum);
  }

  .face small {
    display: block;
    color: var(--color-violet);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .face b {
    display: block;
    margin-top: 6px;
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
  }

  .face span {
    display: inline-block;
    margin-top: 18px;
    padding: 4px 14px;
    border: 3px solid var(--color-plum);
    border-radius: 999px;
    background: #fff;
    font-size: 15px;
    font-weight: 800;
  }

  .rev {
    background: #e9c35e;
    transform: rotateY(180deg);
  }

  .folder:is([data-open], :global(html:not(.js)) :target) .cover {
    transform: perspective(1600px) rotateY(178deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover {
      transition: none;
    }
  }
</style>
