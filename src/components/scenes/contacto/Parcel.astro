---
/**
 * GitHub: una caja de cartón con cinta. Al abrirla tiembla, se corta la cinta y las cuatro tapas se
 * pliegan hacia afuera; adentro está el enlace sobre un relleno de pellets. Lo que trae (pato, tecla
 * Enter, pendrive) salta a la mesa y vuelve adentro si se suelta sobre la caja abierta, y los
 * pellets se arrastran o se lanzan fuera de la mesa (`deskClient.ts`).
 */
import { contact } from '../../../data/contact';
import { HOME, PELLETS, PELLET_SPOTS, spotStyle } from './desk';

interface Props {
  z: number;
}

const item = contact('github')!;
const handle = item.href.replace(/^https?:\/\//, '');
---

<div
  id="github"
  class="desk-obj parcel"
  style={spotStyle(HOME.github, Astro.props.z)}
  data-desk-obj="github"
>
  <a
    href="#github"
    class="desk-hit"
    data-desk-hit="github"
    aria-expanded="false"
    aria-label={item.name}
  ></a>
  <div class="box">
    <div class="inside">
      <div class="pellets" data-pellets aria-hidden="true">
        {PELLET_SPOTS.map((p, i) => (
          <div
            class="desk-obj pellet"
            style={`--x:${p.x}px;--y:${p.y}px;--r:${p.r}deg`}
            data-pellet={i}
          >
            <svg
              width={PELLETS.w}
              height={PELLETS.h}
              viewBox={`${-PELLETS.w / 2} ${-PELLETS.h / 2} ${PELLETS.w} ${PELLETS.h}`}
            >
              <g fill="#2A1B6B" opacity=".16" transform="translate(1 3)">
                <circle cx="-6" r="7"></circle>
                <circle cx="6" cy="1" r="7"></circle>
                <rect x="-6" y="-5" width="12" height="11"></rect>
              </g>
              <g fill={p.color}>
                <circle cx="-6" r="7"></circle>
                <circle cx="6" cy="1" r="7"></circle>
                <rect x="-6" y="-5" width="12" height="11"></rect>
              </g>
              <circle cx="-7" cy="-2" r="2.2" fill="#fff" opacity=".6"></circle>
            </svg>
          </div>
        ))}
      </div>
      <div class="stuck" data-surface="github-dentro"></div>
      <p class="note">{handle}</p>
      <a class="desk-btn pink" href={item.href} target="_blank" rel="noopener">
        Abrir GitHub ↗
      </a>
    </div>
  </div>
  <div class="short t" aria-hidden="true"></div>
  <div class="short b" aria-hidden="true"></div>
  <div class="half l" aria-hidden="true">
    <div class="face">
      <i class="tape-v"></i>
      <i class="tape-h"></i>
      <p class="label">
        <b>&lt;/&gt;</b>
        {handle}
      </p>
      <svg class="arrows" width="40" height="30" viewBox="0 0 40 30">
        <path d="M2 14l8-13 8 13h-5v14h-6V14ZM22 14l8-13 8 13h-5v14h-6V14Z" fill="#B98450"></path>
      </svg>
      <div class="stuck" data-surface="github"></div>
    </div>
    <div class="rev"></div>
  </div>
  <div class="half r" aria-hidden="true">
    <div class="face">
      <i class="tape-v"></i>
      <i class="tape-h"></i>
      <p class="seal">CÓDIGO</p>
      <div class="stuck" data-surface="github"></div>
    </div>
    <div class="rev"></div>
  </div>
</div>

<style>
  .parcel {
    width: 380px;
    height: 290px;
  }

  .box {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 10px;
    background: #e7b67a;
    box-shadow: var(--sh, 8px 10px 0) var(--shadow);
    transition: box-shadow 0.15s;
  }

  .inside {
    position: absolute;
    inset: 0;
    display: grid;
    gap: 14px;
    place-content: center;
    justify-items: center;
    background: #a8733f;
    /* Cerrado, el enlace y los pellets no reciben clics ni foco (las tapas no los tapan para el puntero). */
    visibility: hidden;
    transition: visibility 0s 0.5s;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .inside {
    visibility: visible;
    transition: none;
  }

  .pellets {
    position: absolute;
    inset: 0;
  }

  /* Los pellets reciben el puntero aunque el dibujo de la caja no (también sueltos en la mesa:
     llevan el atributo de este componente). */
  .pellet {
    width: 40px;
    height: 30px;
    pointer-events: auto;
  }

  .note {
    position: relative;
    margin: 0;
    padding: 10px 18px;
    border-radius: 6px;
    background: #fffdf7;
    box-shadow: 4px 6px 0 var(--shadow);
    color: var(--color-plum);
    font-family: var(--font-hand);
    font-size: 26px;
    font-weight: 700;
    rotate: -5deg;
  }

  .inside .desk-btn {
    position: relative;
  }

  /*
   * Tapas: las dos largas se pliegan en el plano (scaleX) sobre los bordes de afuera y quedan como
   * tapas paradas (más angostas); a mitad del pliegue la cara de afuera da paso a la de adentro.
   * Las cortas, debajo de las largas, salen arriba y abajo un poco después.
   */
  .half {
    position: absolute;
    top: 0;
    z-index: 2;
    width: 190px;
    height: 290px;
    transition: transform 0.5s cubic-bezier(0.5, 0, 0.3, 1);
  }

  .half.l {
    left: 0;
    transform-origin: 0 50%;
  }

  .half.r {
    left: 190px;
    transform-origin: 100% 50%;
  }

  .half > div {
    position: absolute;
    inset: 0;
    transition: visibility 0s 0.25s;
  }

  .face {
    background: linear-gradient(transparent 259px, #d9a468 0) #e7b67a;
  }

  /* Los stickers van sobre todo lo de la tapa; la tapa que tiene alguno, sobre la otra (si cruzan
     la unión de las tapas, no quedan cortados). */
  .stuck {
    z-index: 1;
  }

  .half:has(.stuck > :global(*)) {
    z-index: 3;
  }

  .l .face {
    border-radius: 10px 0 0 10px;
  }

  .r .face {
    border-radius: 0 10px 10px 0;
  }

  .rev {
    visibility: hidden;
    background: #d9a468;
  }

  .l .rev {
    clip-path: polygon(0 0, 100% 6%, 100% 94%, 0 100%);
  }

  .r .rev {
    clip-path: polygon(0 6%, 100% 0, 100% 100%, 0 94%);
  }

  .short {
    position: absolute;
    left: 0;
    z-index: 1;
    width: 380px;
    height: 70px;
    /* La cinta cortada sigue pegada al centro de cada tapa. */
    background: linear-gradient(90deg, transparent 167px, #f5e6b8 0 213px, transparent 0) #e7b67a;
    visibility: hidden;
    transition:
      transform 0.45s cubic-bezier(0.5, 0, 0.3, 1),
      visibility 0s 0.45s;
  }

  .short.t {
    top: 0;
    clip-path: polygon(0 0, 100% 0, 94% 100%, 6% 100%);
    transform-origin: 50% 0;
  }

  .short.b {
    bottom: 0;
    clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%);
    transform-origin: 50% 100%;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .half {
    transform: scaleX(-0.42);
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .short {
    visibility: visible;
    transform: scaleY(-1);
    transition:
      transform 0.45s cubic-bezier(0.5, 0, 0.3, 1) 0.15s,
      visibility 0s 0.15s;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .face {
    visibility: hidden;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .rev {
    visibility: visible;
  }

  .parcel:global([data-shake]) {
    animation: shake 0.3s;
  }

  @keyframes shake {
    25% {
      rotate: calc(var(--r) - 3deg);
    }
    75% {
      rotate: calc(var(--r) + 3deg);
    }
  }

  .tape-v,
  .tape-h {
    position: absolute;
    background: #f5e6b8;
    opacity: 0.92;
  }

  .tape-v {
    top: 0;
    width: 23px;
    height: 100%;
  }

  .l .tape-v {
    right: 0;
  }

  .r .tape-v {
    left: 0;
  }

  .tape-h {
    top: 121px;
    width: 100%;
    height: 48px;
  }

  .label {
    position: absolute;
    top: 22px;
    left: 20px;
    width: 150px;
    margin: 0;
    padding: 8px 6px;
    border-radius: 8px;
    background: #fffdf7;
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: 17px;
    font-weight: 700;
    rotate: -4deg;
    text-align: center;
  }

  .label b {
    display: block;
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
  }

  .arrows {
    position: absolute;
    bottom: 50px;
    left: 34px;
  }

  .seal {
    position: absolute;
    right: 28px;
    bottom: 52px;
    display: grid;
    width: 70px;
    height: 70px;
    margin: 0;
    border: 5px solid var(--color-hotpink);
    border-radius: 50%;
    color: var(--color-plum);
    font-size: 12px;
    font-weight: 800;
    place-items: center;
  }

  /* Al arrastrar algo del paquete encima (abierto), se marca dónde soltarlo. */
  .parcel:global([data-target]) .box {
    outline: 5px dashed var(--color-sun);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .half,
    .half > div,
    .short,
    .parcel:is([data-open], :global(html:not(.js)) :target) .short {
      transition: none;
    }

    .parcel:global([data-shake]) {
      animation: none;
    }
  }
</style>
