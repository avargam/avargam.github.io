---
/**
 * GitHub: un paquete con cinta. Al abrirlo tiembla, se corta la cinta y las tapas se pliegan hacia
 * afuera; adentro está el enlace. Lo que trae (pato, tecla, disquete) salta a la mesa y vuelve
 * adentro si se suelta sobre el paquete abierto (`deskClient.ts`).
 */
import { contact } from '../../../data/contact';
import { HOME, spotStyle } from './desk';

interface Props {
  z: number;
}

const item = contact('github')!;
const handle = item.href.replace(/^https?:\/\//, '');
---

<div
  id="github"
  class="desk-obj parcel"
  style={spotStyle(HOME.github, Astro.props.z)}
  data-desk-obj="github"
>
  <a
    href="#github"
    class="desk-hit"
    data-desk-hit="github"
    aria-expanded="false"
    aria-label={item.name}
  ></a>
  <div class="box">
    <div class="inside">
      <p class="note">{handle}</p>
      <a class="desk-btn pink" href={item.href} target="_blank" rel="noopener">
        Abrir GitHub ↗
      </a>
    </div>
  </div>
  <div class="half l" aria-hidden="true">
    <div class="face">
      <i class="tape-v"></i>
      <i class="tape-h"></i>
      <p class="label">
        <b>&lt;/&gt;</b>
        {handle}
      </p>
    </div>
    <div class="rev"></div>
  </div>
  <div class="half r" aria-hidden="true">
    <div class="face">
      <i class="tape-v"></i>
      <i class="tape-h"></i>
      <p class="seal">CÓDIGO</p>
    </div>
    <div class="rev"></div>
  </div>
</div>

<style>
  .parcel {
    width: 380px;
    height: 290px;
  }

  .box {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 5px solid var(--color-plum);
    border-radius: 10px;
    background: #b98450;
    box-shadow: var(--sh, 8px 10px 0) var(--shadow);
    transition: box-shadow 0.15s;
  }

  .inside {
    position: absolute;
    inset: 0;
    display: grid;
    gap: 10px;
    place-content: center;
    justify-items: center;
    background:
      radial-gradient(circle at 20% 30%, #f5e6b8 0 7px, transparent 8px),
      radial-gradient(circle at 70% 20%, #ffe0cc 0 6px, transparent 7px),
      radial-gradient(circle at 80% 75%, #f5e6b8 0 8px, transparent 9px),
      radial-gradient(circle at 30% 80%, #ffe0cc 0 6px, transparent 7px), #a8733f;
    /* Cerrado, el enlace no recibe clics ni foco (las tapas no lo tapan para el puntero). */
    visibility: hidden;
    transition: visibility 0s 0.5s;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .inside {
    visibility: visible;
    transition: none;
  }

  .note {
    margin: 0;
    padding: 10px 16px;
    border: 3px solid var(--color-plum);
    border-radius: 6px;
    background: #fffdf7;
    color: var(--color-plum);
    font-family: var(--font-hand);
    font-size: 26px;
    font-weight: 700;
    rotate: -3deg;
  }

  /* Las tapas se pliegan en el plano (scaleX): a mitad del pliegue la cara de afuera da paso a la de adentro. */
  .half {
    position: absolute;
    top: 0;
    width: 190px;
    height: 290px;
    transition: transform 0.5s cubic-bezier(0.5, 0, 0.3, 1);
  }

  .half.l {
    left: 0;
    transform-origin: 0 50%;
  }

  .half.r {
    left: 190px;
    transform-origin: 100% 50%;
  }

  .half > div {
    position: absolute;
    inset: 0;
    transition: visibility 0s 0.25s;
  }

  .face {
    border: 5px solid var(--color-plum);
    background: #e7b67a;
  }

  .l .face {
    border-right: 0;
    border-radius: 10px 0 0 10px;
  }

  .r .face {
    border-left: 0;
    border-radius: 0 10px 10px 0;
  }

  .rev {
    visibility: hidden;
    border: 4px solid var(--color-plum);
    background: #d9a468;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .half {
    transform: scaleX(-1);
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .face {
    visibility: hidden;
  }

  .parcel:is([data-open], :global(html:not(.js)) :target) .rev {
    visibility: visible;
  }

  .parcel:global([data-shake]) {
    animation: shake 0.3s;
  }

  @keyframes shake {
    25% {
      rotate: calc(var(--r) - 3deg);
    }
    75% {
      rotate: calc(var(--r) + 3deg);
    }
  }

  .tape-v {
    position: absolute;
    top: 0;
    width: 30px;
    height: 100%;
    background: #f5e6b8;
    opacity: 0.92;
  }

  .l .tape-v {
    right: 0;
  }

  .r .tape-v {
    left: 0;
  }

  .tape-h {
    position: absolute;
    top: 123px;
    width: 100%;
    height: 48px;
    background: #f5e6b8;
    opacity: 0.92;
  }

  .label {
    position: absolute;
    top: 17px;
    left: 17px;
    width: 150px;
    margin: 0;
    padding: 6px;
    border: 3px solid var(--color-plum);
    border-radius: 6px;
    background: #fffdf7;
    color: var(--color-ink);
    font-family: var(--font-hand);
    font-size: 18px;
    font-weight: 700;
    text-align: center;
  }

  .label b {
    display: block;
    color: var(--color-plum);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
  }

  .seal {
    position: absolute;
    right: 17px;
    bottom: 19px;
    display: grid;
    width: 74px;
    height: 74px;
    margin: 0;
    border: 4px solid var(--color-hotpink);
    border-radius: 50%;
    color: var(--color-plum);
    font-size: 12px;
    font-weight: 800;
    place-items: center;
  }

  /* Al arrastrar algo del paquete encima (abierto), se marca dónde soltarlo. */
  .parcel:global([data-target]) .box {
    outline: 5px dashed var(--color-sun);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .half,
    .half > div {
      transition: none;
    }

    .parcel:global([data-shake]) {
      animation: none;
    }
  }
</style>
