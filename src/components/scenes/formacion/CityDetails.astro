---
/**
 * Detalle de cada edificio, como parte de la ciudad (coordenadas de la escena). Cada capa es un
 * `[data-item-detail]` que se muestra al llegar la cámara (`data-active`) y anima su entrada:
 * - Título: inscripción en el friso y pendón entre columnas.
 * - Major: letrero vertical "SOFTWARE" y globo aerostático con un lienzo.
 * - Minor: el cartel de la azotea se vuelve un panel de datos.
 * - Idiomas: la pantalla publicitaria se enciende.
 * Diseño en `prototype/detalle-v2/`.
 */
import {
  degree,
  degreeNote,
  degreeProgress,
  languages,
  major,
  minor,
} from '../../../data/education';

const progress = degreeProgress();
const stripes = ['#FF6FA3', '#FFE86B', '#8ADBC8', '#C6B8FF', '#FF9E7A', '#FF6FA3', '#FFE86B'];
const sparks = [
  { d: 'M0 8 L10 6 L20 7 L30 3 L40 4 L54 1', color: '#8ADBC8' },
  { d: 'M0 9 L12 5 L22 6 L34 2 L54 3', color: '#FF6FA3' },
  { d: 'M0 7 L9 8 L19 4 L29 5 L41 2 L54 2', color: '#FFE86B' },
  { d: 'M0 9 L14 7 L26 7 L36 4 L54 2', color: '#C6B8FF' },
];
const [es, en] = languages;
const cert = en.cert ? `${en.cert.name} ${en.cert.score}/${en.cert.max} · ${en.cert.year}` : '';
---

<div class="city-details pointer-events-none absolute inset-0">
  <article id="titulo" data-item-detail="titulo" class="detail" aria-labelledby="titulo-h">
    <h2 id="titulo-h" class="frieze">
      {degree.title}
    </h2>
    <div class="pendon">
      <div class="pendon-cloth">
        <p class="pendon-org-short">PUC · CHILE</p>
        <p class="pendon-org">{degree.org}</p>
        <p class="pendon-dates">
          {degree.startLabel} → {degree.endLabel}
        </p>
        <div
          class="pendon-bar"
          role="progressbar"
          aria-label="Avance de la carrera"
          aria-valuenow={Math.round(progress * 100)}
          aria-valuemin="0"
          aria-valuemax="100"
        >
          <span style={`width:${progress * 100}%`}></span>
        </div>
        <p class="pendon-note">{degreeNote()}</p>
      </div>
      <span class="pendon-rod" aria-hidden="true"></span>
    </div>
  </article>

  <article id="major" data-item-detail="major" class="detail" aria-labelledby="major-h">
    <div class="blade" aria-hidden="true">
      {[...'SOFTWARE'].map((c, i) => (
        <b style={`animation-delay:${0.3 + i * 0.12}s`}>{c}</b>
      ))}
    </div>
    <svg class="blade-brackets" viewBox="0 0 1600 1000" aria-hidden="true">
      <path d="M466 490h4M466 750h4" stroke="#1B1245" stroke-width="3"></path>
    </svg>
    <div class="balloon">
      <div class="balloon-float">
        <svg width="280" height="226" viewBox="0 0 280 226" aria-hidden="true">
          <defs>
            <clipPath id="formacion-balloon">
              <path d="M140 4C70 4 34 52 34 104c0 46 40 74 70 96h72c30-22 70-50 70-96C246 52 210 4 140 4Z"></path>
            </clipPath>
          </defs>
          <g clip-path="url(#formacion-balloon)">
            {stripes.map((c, i) => (
              <rect x={34 + i * 30} y="0" width="30" height="210" fill={c} />
            ))}
            <rect x="0" y="92" width="280" height="30" fill="#5A2F6B"></rect>
            <text
              x="140"
              y="113"
              text-anchor="middle"
              font-family="Bricolage Grotesque Variable, sans-serif"
              font-weight="800"
              font-size="16"
              letter-spacing="1.5"
              fill="#F9DDF0"
            >
              MAJOR · SOFTWARE
            </text>
            <path
              d="M60 30q80-30 150 10"
              stroke="#fff"
              stroke-width="8"
              fill="none"
              opacity=".35"
            ></path>
          </g>
          <path
            d="M140 4C70 4 34 52 34 104c0 46 40 74 70 96h72c30-22 70-50 70-96C246 52 210 4 140 4Z"
            fill="none"
            stroke="#5A2F6B"
            stroke-width="4"
          ></path>
          <path d="M106 200 118 214M174 200 162 214" stroke="#5A2F6B" stroke-width="2.5"></path>
          <path class="flame" d="M140 196c-6-8 0-14 0-20 4 6 8 12 0 20Z" fill="#FFB347"></path>
          <rect
            x="116"
            y="212"
            width="48"
            height="14"
            rx="3"
            fill="#7D4690"
            stroke="#5A2F6B"
            stroke-width="2.5"
          ></rect>
        </svg>
        <div class="balloon-tag">
          <h2 id="major-h">
            {major.kind} en {major.name}
          </h2>
          <p>{major.summary}</p>
          <ul>
            {major.skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </article>

  <article id="minor" data-item-detail="minor" class="detail" aria-labelledby="minor-h">
    <div class="dash">
      <h2 id="minor-h" class="sr-only">
        {minor.kind} en {minor.name}
      </h2>
      <p class="dash-ticker">
        <span>
          {minor.kind} · {minor.name} — {minor.summary}
        </span>
      </p>
      <ul class="dash-tiles">
        {(minor.short ?? minor.skills).map((s, i) => (
          <li style={`animation-delay:${0.3 + i * 0.15}s`}>
            <span class="sr-only">{minor.skills[i]}</span>
            <b aria-hidden="true">{s}</b>
            <svg width="54" height="10" viewBox="0 0 54 10" aria-hidden="true">
              <path
                d={sparks[i].d}
                fill="none"
                stroke={sparks[i].color}
                stroke-width="1.3"
                style={`animation-delay:${0.5 + i * 0.15}s`}
              />
            </svg>
          </li>
        ))}
      </ul>
    </div>
  </article>

  <article id="idiomas" data-item-detail="idiomas" class="detail" aria-labelledby="idiomas-h">
    <div class="led screen">
      <h2 id="idiomas-h" class="sr-only">
        Idiomas
      </h2>
      <span class="led-static" aria-hidden="true"></span>
      <ul class="screen-rows">
        {[es, en].map((l, i) => (
          <li class="screen-row">
            <span
              class:list={['px pixel-in screen-code', i ? 'on-m' : 'on-p']}
              style={`animation-delay:${0.55 + i * 0.3}s`}
              aria-hidden="true"
            >
              {l.code}
            </span>
            <span class="screen-text">
              <span
                class:list={['px pixel-in screen-name', i ? 'on-m' : 'on-p']}
                style={`animation-delay:${0.75 + i * 0.3}s`}
              >
                {l.name.toUpperCase()}
              </span>
              <span
                class="px on-y pixel-in screen-level"
                style={`animation-delay:${0.95 + i * 0.3}s`}
              >
                {l.level.toUpperCase()}
              </span>
            </span>
          </li>
        ))}
      </ul>
      {cert && (
        <p class="screen-ticker">
          <span class="px on-y">
            {cert} <span aria-hidden="true">✦ {cert} ✦</span>
          </span>
        </p>
      )}
    </div>
  </article>
</div>

<style>
  .detail {
    display: none;
  }

  .detail[data-active] {
    display: block;
  }

  /* ---------- Título ---------- */
  .frieze {
    position: absolute;
    top: 696px;
    left: 700px;
    width: 360px;
    color: var(--color-plum);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.4px;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    animation: chisel 1.6s 0.2s steps(31, end) both;
  }

  @keyframes chisel {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  .pendon {
    position: absolute;
    top: 716px;
    left: 822px;
    width: 116px;
    height: 150px;
    transform-origin: 50% 0;
    filter: drop-shadow(1.5px 2px 0 rgb(0 0 0 / 0.25));
    animation:
      unroll 0.7s 0.4s cubic-bezier(0.3, 1.3, 0.5, 1) both,
      sway 4s 1.2s ease-in-out infinite;
  }

  .pendon-cloth {
    position: absolute;
    inset: 0;
    padding: 12px 9px 0;
    background: var(--color-pink);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 90%, 0 100%);
    color: var(--color-ink);
    text-align: center;
  }

  .pendon-org-short {
    font: 800 11px/1 var(--font-display);
  }

  .pendon-org {
    margin-top: 5px;
    font-size: 6.2px;
    font-weight: 700;
    line-height: 1.25;
  }

  .pendon-dates {
    margin-top: 9px;
    font: 800 8.5px var(--font-display);
  }

  .pendon-bar {
    height: 5px;
    margin: 5px 4px 0;
    overflow: hidden;
    border-radius: 3px;
    background: #ffd3e6;
  }

  .pendon-bar span {
    display: block;
    height: 100%;
    background: var(--color-plum);
    animation: grow-x 1.5s 1.1s ease-out both;
    transform-origin: 0 50%;
  }

  .pendon-note {
    margin-top: 4px;
    font-size: 5.6px;
    font-weight: 700;
  }

  .pendon-rod {
    position: absolute;
    top: -2px;
    right: -4px;
    left: -4px;
    height: 3px;
    border-radius: 2px;
    background: #3a3f5c;
  }

  /* ---------- Major ---------- */
  .blade {
    position: absolute;
    top: 470px;
    left: 436px;
    display: flex;
    width: 30px;
    height: 300px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border: 3px solid #0e0828;
    border-radius: 6px;
    background: #1b1245;
    color: #ffd3e6;
    font: 800 21px var(--font-display);
    text-shadow:
      0 0 6px var(--color-pink),
      0 0 14px var(--color-hotpink);
  }

  .blade b {
    animation: neon-on 0.2s both;
  }

  @keyframes neon-on {
    0% {
      color: #3b2a60;
      text-shadow: none;
    }
    40% {
      color: #fff;
      text-shadow: 0 0 8px var(--color-hotpink);
    }
    60% {
      color: #3b2a60;
      text-shadow: none;
    }
  }

  .blade-brackets {
    position: absolute;
    inset: 0;
    width: 1600px;
    height: 1000px;
  }

  .balloon {
    position: absolute;
    top: 0;
    left: 0;
    width: 280px;
    transform: translate(650px, 176px);
    animation: drift 2.6s cubic-bezier(0.2, 0.7, 0.25, 1) both;
  }

  @keyframes drift {
    from {
      transform: translate(1250px, -420px) rotate(6deg);
    }
  }

  .balloon-float {
    animation: float 4.5s 2.6s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-7px) rotate(-1.2deg);
    }
  }

  .balloon svg {
    overflow: visible;
  }

  .flame {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flame 0.35s ease-in-out infinite alternate;
  }

  @keyframes flame {
    to {
      transform: scaleY(0.6) scaleX(0.85);
    }
  }

  .balloon-tag {
    position: absolute;
    top: 232px;
    left: -10px;
    width: 300px;
    padding: 9px 12px 10px;
    border: 2px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-paper);
    color: var(--color-ink);
    filter: drop-shadow(1.5px 2px 0 rgb(0 0 0 / 0.25));
    transform-origin: 50% 0;
    animation:
      unroll 0.7s 2.5s cubic-bezier(0.3, 1.3, 0.5, 1) both,
      sway 4s 3.2s ease-in-out infinite;
  }

  .balloon-tag h2 {
    font-size: 15px;
    font-weight: 800;
  }

  .balloon-tag p {
    margin-top: 3px;
    color: var(--color-muted);
    font-size: 9.6px;
    font-weight: 600;
    line-height: 1.3;
  }

  .balloon-tag ul {
    margin-top: 5px;
    padding-left: 10px;
    list-style: disc;
  }

  .balloon-tag li {
    margin-top: 2px;
    font-size: 9.6px;
    font-weight: 700;
    line-height: 1.3;
  }

  /* ---------- Minor ---------- */
  .dash {
    position: absolute;
    top: 474px;
    left: 1140px;
    width: 130px;
    height: 82px;
    overflow: hidden;
    border-radius: 4px;
    background: #1b1245;
    animation: fade-in 0.3s 0.1s both;
  }

  .dash-ticker {
    overflow: hidden;
    padding: 2px 0;
    border-bottom: 0.5px solid #3b2a80;
    color: var(--color-sun);
    font-size: 4.6px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dash-ticker span {
    display: inline-block;
    padding-left: 100%;
    animation: marquee 9s linear infinite;
  }

  .dash-tiles {
    display: grid;
    gap: 3px;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
  }

  .dash-tiles li {
    padding: 2.5px 3px;
    border-radius: 2px;
    background: #2a1b6b;
    animation: pop 0.35s both;
  }

  .dash-tiles b {
    display: block;
    color: #fff;
    font-size: 4px;
    font-weight: 700;
  }

  .dash-tiles svg {
    display: block;
    margin-top: 2px;
  }

  .dash-tiles path {
    stroke-dasharray: 80;
    animation: draw 1.2s ease-out both;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 80;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  /* ---------- Idiomas ---------- */
  .screen {
    position: absolute;
    top: 598px;
    left: 206px;
    width: 218px;
    height: 118px;
    animation: power-on 0.6s both;
  }

  .led-static {
    position: absolute;
    z-index: 2;
    inset: 0;
    opacity: 0;
    background:
      repeating-linear-gradient(0deg, #fff3 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, #0b0720 0 7px, #2c1f66 7px 9px, #0b0720 9px 15px);
    animation: static 0.45s steps(6);
  }

  @keyframes static {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.9;
      transform: translateY(-6px);
    }
    100% {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .screen-rows {
    position: absolute;
    inset: 8px 12px 24px;
    display: grid;
    gap: 4px;
    grid-template-rows: 1fr 1fr;
  }

  .screen-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .screen-code {
    font-size: 28px;
  }

  .screen-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .screen-name {
    font-size: 9.5px;
  }

  .screen-level {
    font-size: 12px;
  }

  .screen-ticker {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    height: 20px;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid #2c1f66;
  }

  .screen-ticker > span {
    display: inline-block;
    padding-left: 100%;
    font-size: 9px;
    animation: marquee 8s linear infinite;
  }

  .pixel-in {
    animation: pixel-in 0.9s steps(9) both;
  }

  @keyframes pixel-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  /* ---------- Comunes ---------- */
  @keyframes unroll {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes sway {
    50% {
      transform: rotate(1.2deg);
    }
  }

  @keyframes grow-x {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @keyframes power-on {
    0% {
      clip-path: inset(50% 0 50% 0);
      filter: brightness(3);
    }
    60% {
      clip-path: inset(0 0 0 0);
      filter: brightness(1.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .city-details *,
    .city-details *::before {
      animation: none !important;
    }
  }
</style>
