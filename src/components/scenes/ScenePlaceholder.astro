---
/**
 * Provisional: imagen del prototipo (escena sin UI) mientras la escena no esté portada.
 * Cada fase que porta una escena borra su imagen de `src/assets/placeholders/`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { SectionSlug } from '../../data/sections';
import fueraDelCodigo from '../../assets/placeholders/fuera-del-codigo.webp';
import contacto from '../../assets/placeholders/contacto.webp';

interface Props {
  slug: SectionSlug;
}

const images: Partial<Record<SectionSlug, ImageMetadata>> = {
  'fuera-del-codigo': fueraDelCodigo,
  contacto,
};
const image = images[Astro.props.slug];
---

{image && (
  <Image
    src={image}
    alt=""
    width={1600}
    height={1000}
    densities={[1, 2]}
    class="absolute inset-0 h-full w-full"
    draggable="false"
  />
)}
