---
/**
 * Ventana de un proyecto. Crece desde su carpeta al abrirse (`data-active`) y se minimiza hacia
 * su pestaña de la barra de tareas al cerrarla o elegir otro (`data-leaving`). La vista previa
 * animada arranca con la ventana abierta.
 */
import type { ProyectosItem } from './desk';
import { windowTo, WINDOW } from './desk';
import SudokuPreview from './previews/SudokuPreview.astro';
import RecetarioPreview from './previews/RecetarioPreview.astro';
import SitePreview from './previews/SitePreview.astro';

interface Props {
  item: ProyectosItem;
  index: number;
  total: number;
}

const { item, index, total } = Astro.props;
const { project } = item;
const from = windowTo({ x: item.folder.x + 10, y: item.folder.y + 10, w: 110, h: 80 });
const to = windowTo({ ...item.tab, h: item.tab.h * 1.4 });
const vars = [
  `left:${WINDOW.x}px;top:${WINDOW.y}px;width:${WINDOW.w}px;height:${WINDOW.h}px`,
  `--open-translate:${from.translate};--open-scale:${from.scale}`,
  `--min-translate:${to.translate};--min-scale:${to.scale}`,
].join(';');
const tagColors = [
  'var(--color-mint)',
  'var(--color-lilac)',
  'var(--color-sun)',
  'var(--color-peach)',
];
---

<article
  id={project.id}
  data-item-detail={project.id}
  class="window"
  style={vars}
  aria-labelledby={`${project.id}-h`}
>
  <div class="titlebar">
    <span>{project.window}</span>
    <span class="controls">
      <a href="#" data-item-clear aria-label="Minimizar">
        –
      </a>
      <span aria-hidden="true">▢</span>
      <a href="#" data-item-clear aria-label="Cerrar">
        ×
      </a>
    </span>
  </div>

  <div class="preview">
    {project.id === 'sudoku' && <SudokuPreview />}
    {project.id === 'recetario' && <RecetarioPreview />}
    {project.id === 'sitio' && <SitePreview />}
  </div>
  <p class="legend reveal" style="--i: 4">
    {project.legend}
  </p>

  <div class="info">
    <p class="eyebrow reveal">{project.eyebrow}</p>
    <h2 id={`${project.id}-h`} class="reveal" style="--i: 1">
      {project.title}
    </h2>
    <p class="reveal" style="--i: 2">
      {project.description}
    </p>
    <ul class="tags reveal" style="--i: 3" aria-label="Tecnologías">
      {project.tags.map((tag, i) => (
        <li style={`background:${tagColors[i % 4]}`}>{tag}</li>
      ))}
    </ul>
    {project.highlight && (
      <p class="highlight reveal" style="--i: 4">
        {project.highlight}
      </p>
    )}
  </div>

  <div class="links reveal" style="--i: 5">
    {project.links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener" class:list={[link.primary && 'primary']}>
        {link.label}
        {link.primary && <span aria-hidden="true"> ↗</span>}
        <span class="sr-only"> (se abre en otra pestaña)</span>
      </a>
    ))}
  </div>

  <p class="status">
    {index + 1} de {total} proyectos
  </p>
</article>

<style>
  .window {
    position: absolute;
    display: none;
    border: 5px solid var(--color-plum);
    border-radius: 12px;
    background: var(--color-wall);
    box-shadow: 8px 10px 0 var(--color-plum);
    color: var(--color-ink);
    transform-origin: 0 0;
  }

  .window:is([data-active], [data-leaving]) {
    display: block;
  }

  .titlebar {
    display: flex;
    height: 46px;
    align-items: center;
    margin: -5px -5px 0;
    padding: 0 8px 0 18px;
    border: 5px solid var(--color-plum);
    border-radius: 10px 10px 0 0;
    background: linear-gradient(90deg, var(--color-pink), var(--color-violet));
    color: #fff;
    font-size: 18px;
    font-weight: 800;
  }

  .controls {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .controls > * {
    display: grid;
    width: 30px;
    height: 30px;
    border: 3px solid var(--color-plum);
    border-radius: 6px;
    background: var(--color-wall);
    color: var(--color-plum);
    font-size: 16px;
    font-weight: 800;
    place-items: center;
    text-decoration: none;
  }

  .controls a:hover {
    background: var(--color-sun);
  }

  .preview {
    position: absolute;
    top: 77px;
    left: 32px;
    width: 460px;
    height: 340px;
    overflow: hidden;
    border: 4px solid var(--color-plum);
    border-radius: 10px;
    background: var(--color-night);
  }

  .preview > :global(*) {
    position: absolute;
    inset: 0;
  }

  .legend {
    position: absolute;
    top: 433px;
    left: 32px;
    color: var(--color-muted);
    font-size: 15px;
  }

  .info {
    position: absolute;
    top: 81px;
    right: 34px;
    left: 530px;
  }

  .eyebrow {
    color: #6253e0;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    margin: 14px 0 16px;
    font-size: 44px;
    font-weight: 800;
    line-height: 1.05;
  }

  .info > p:not(.eyebrow, .highlight) {
    font-size: 19px;
    line-height: 28px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .tags li {
    padding: 6px 15px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 700;
  }

  .highlight {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    color: var(--color-plum);
    font-size: 15px;
    font-weight: 700;
  }

  .highlight::before {
    color: var(--color-hotpink);
    content: '★';
    font-size: 20px;
  }

  .links {
    position: absolute;
    top: 501px;
    left: 32px;
    display: flex;
    gap: 14px;
  }

  .links a {
    display: grid;
    height: 50px;
    padding: 0 30px;
    border: 3px solid var(--color-plum);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 800;
    place-items: center;
    grid-auto-flow: column;
    text-decoration: none;
  }

  .links a.primary {
    border-color: var(--color-pink);
    background: var(--color-pink);
  }

  .links a:hover {
    border-color: var(--color-plum);
    background: var(--color-sun);
  }

  .status {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 44px;
    padding: 12px 20px;
    border-top: 3px solid var(--color-lilac);
    color: var(--color-muted);
    font-size: 14px;
  }

  /* Abrir: crece desde la carpeta; el contenido entra escalonado. */
  .window[data-active] {
    animation: window-open 0.52s cubic-bezier(0.2, 0.9, 0.25, 1) both;
  }

  .window[data-active] .reveal {
    animation: window-reveal 0.35s calc(0.35s + var(--i, 0) * 70ms) both;
  }

  @keyframes window-open {
    from {
      opacity: 0.3;
      scale: var(--open-scale);
      translate: var(--open-translate);
    }
  }

  @keyframes window-reveal {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }

  /* Minimizar: se va hacia su pestaña. */
  .window[data-leaving] {
    animation: window-minimize 0.38s cubic-bezier(0.5, 0, 0.75, 0) forwards;
    pointer-events: none;
  }

  @keyframes window-minimize {
    to {
      opacity: 0;
      scale: var(--min-scale);
      translate: var(--min-translate);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .window,
    .window .reveal {
      animation: none !important;
    }

    .window[data-leaving] {
      display: none;
    }
  }
</style>
