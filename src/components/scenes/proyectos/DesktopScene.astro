---
/**
 * Escena de Proyectos: la pantalla del monitor, un escritorio vaporwave. Es la misma en el cuarto
 * (escala 0.195) y a pantalla completa. Cada proyecto es una carpeta; al elegirlo, su ventana
 * crece desde la carpeta (`ProjectWindow`) y la anterior se minimiza a su pestaña. La barra de
 * tareas son los chips de ítems. La cámara no se acerca a los ítems.
 */
import ProjectWindow from './ProjectWindow.astro';
import { proyectosItems } from './desk';
import desktop from './art/desktop.svg?raw';

/** Silueta de la carpeta: la parte de atrás con su pestaña. */
const FOLDER_BACK = 'M0 8Q0 2 6 2H26Q30 2 32 5L36 11H70Q76 11 76 17V56Q76 62 70 62H6Q0 62 0 56Z';
/** El frente abierto: se inclina hacia adelante y deja asomar la hoja. */
const FOLDER_OPEN = 'M-4 26Q-4 22 0 22H76Q80 22 79 26L74 58Q73 62 69 62H6Q2 62 1 58Z';

const rect = (r: { x: number; y: number; w: number; h: number }) =>
  `left:${r.x}px;top:${r.y}px;width:${r.w}px;height:${r.h}px`;

/** La pestaña parpadea cuando su ventana se minimiza hacia ella. */
const tabCss = proyectosItems
  .map(
    ({ id }) =>
      `[data-items]:has(#${id}[data-leaving]) [data-item-chip="${id}"] { animation: tab-flash 0.5s; }`,
  )
  .join('\n');

/** Sin JS, una pestaña (#ítem) abre la ventana, sin animación. */
const noJsCss = proyectosItems
  .map(
    ({ id }) => `html:not(.js) #${id}:target { display: block; }
html:not(.js) [data-items]:has(#${id}:target) [data-item-chip="${id}"] { background: var(--color-wall); color: var(--color-plum); box-shadow: inset 0 -3px var(--color-pink); }`,
  )
  .join('\n');
---

<div class="desktop absolute inset-0" data-items>
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1600 1000" aria-hidden="true">
    <g class="wallpaper" set:html={desktop} />
  </svg>

  <div class="menubar">
    <span class="font-display text-[18px] font-extrabold" aria-hidden="true">
      ◆ avargam
    </span>
    <span class="font-bold" aria-hidden="true">
      Proyectos
    </span>
    <details class="help">
      <summary>
        <span aria-hidden="true">?</span>
        <span class="sr-only">Ayuda</span>
      </summary>
      <dl class="help-list">
        <div>
          <dt>Abrir un proyecto</dt>
          <dd>
            <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd>
          </dd>
        </div>
        <div>
          <dt>Recorrer</dt>
          <dd>
            <kbd>←</kbd> <kbd>→</kbd>
          </dd>
        </div>
        <div>
          <dt>Minimizar · volver al cuarto</dt>
          <dd>
            <kbd>Esc</kbd>
          </dd>
        </div>
      </dl>
    </details>
    <span class="status-area" aria-hidden="true">
      <span class="battery"></span>
      <time class="clock" data-clock></time>
    </span>
  </div>

  {proyectosItems.map(({ id, name, project, folder }) => (
    <button
      type="button"
      class="folder absolute"
      style={rect(folder)}
      data-item-hit={id}
      aria-label={name}
      aria-controls={id}
      aria-pressed="false"
    >
      <svg
        class="folder-icon"
        width="88"
        height="70"
        viewBox="-6 -2 88 70"
        style={`--c:${project.color}`}
        aria-hidden="true"
      >
        <path d={FOLDER_BACK} fill="#2A1B6B" opacity=".2" transform="translate(3 5)" />
        <path class="folder-back" d={FOLDER_BACK} />
        <g class="folder-sheet">
          <rect x="8" width="58" height="40" rx="3" fill="#FBF4FF" />
          <path
            d="M16 10H52M16 18H48M16 26H44"
            stroke="#DAD0FF"
            stroke-width="3"
            stroke-linecap="round"
          />
        </g>
        <g class="folder-closed">
          <rect class="folder-front" y="18" width="76" height="44" rx="6" />
          <rect class="folder-lip" y="18" width="76" height="6" rx="3" />
        </g>
        <g class="folder-open">
          <path class="folder-front" d={FOLDER_OPEN} />
          <path class="folder-lip" d="M-4 26Q-4 22 0 22H76Q80 22 79 26V28H-4Z" />
        </g>
      </svg>
      <span class="folder-name" aria-hidden="true">
        {project.folder.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </span>
    </button>
  ))}

  {proyectosItems.map((item, i) => (
    <ProjectWindow item={item} index={i} total={proyectosItems.length} />
  ))}

  <div class="taskbar" aria-hidden="true">
    <span class="start">◆</span>
  </div>
  <nav class="contents" aria-label="Proyectos">
    {proyectosItems.map(({ id, chip, tab }, i) => (
      <a href={`#${id}`} class="tab absolute" style={rect(tab)} data-item-chip={id}>
        <span class="tab-number" aria-hidden="true">
          {i + 1}
        </span>
        {chip}
      </a>
    ))}
  </nav>
</div>

<style is:inline set:html={tabCss} />
<style is:inline set:html={noJsCss} />

<style>
  /*
   * Ambiente (con el cuarto en reposo y también dentro de Proyectos, ver `--ambient-state` en
   * World.astro): las líneas horizontales de la grilla avanzan cada una hasta la siguiente (el ciclo
   * se repite sin salto).
   */
  :global([data-view='proyectos']) .desktop {
    --ambient-state: running;
  }

  .wallpaper :global(line[x1='56']) {
    animation: grid-run 2.6s linear infinite;
    animation-play-state: var(--ambient-state, paused);
  }

  .wallpaper :global(line[y1='664']) {
    --dy: 12px;
  }
  .wallpaper :global(line[y1='676']) {
    --dy: 21px;
  }
  .wallpaper :global(line[y1='697']) {
    --dy: 29px;
  }
  .wallpaper :global(line[y1='726']) {
    --dy: 37px;
  }
  .wallpaper :global(line[y1='763']) {
    --dy: 45px;
  }
  .wallpaper :global(line[y1='808']) {
    --dy: 54px;
  }
  .wallpaper :global(line[y1='862']) {
    --dy: 62px;
  }
  .wallpaper :global(line[y1='924']) {
    --dy: 70px;
  }

  @keyframes grid-run {
    to {
      transform: translateY(var(--dy));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wallpaper :global(line) {
      animation: none;
    }
  }

  /* Encima de las ventanas, para que el menú Ayuda no quede detrás. */
  .menubar {
    position: absolute;
    z-index: 1;
    top: 50px;
    left: 56px;
    display: flex;
    width: 1488px;
    height: 38px;
    align-items: center;
    gap: 32px;
    /* A la derecha queda espacio para el botón de la música, que va en la esquina de la pantalla. */
    padding-right: 84px;
    padding-left: 244px;
    background: rgb(249 221 240 / 0.92);
    color: var(--color-plum);
    font-size: 17px;
  }

  .help {
    position: relative;
  }

  .help summary {
    display: grid;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-plum);
    color: var(--color-wall);
    cursor: pointer;
    font-size: 16px;
    font-weight: 800;
    list-style: none;
    place-items: center;
    transition: background 0.2s;
  }

  .help summary:hover {
    background: var(--color-desk);
  }

  .help summary::-webkit-details-marker {
    display: none;
  }

  .help[open] summary {
    background: var(--color-pink);
    color: var(--color-ink);
  }

  .help-list {
    position: absolute;
    top: 38px;
    left: 0;
    width: 380px;
    padding: 6px 12px;
    border-radius: 14px;
    background: #fbf4ff;
    box-shadow: 6px 8px 0 rgb(42 27 107 / 0.2);
    color: var(--color-ink);
    font-size: 15px;
    font-weight: 600;
  }

  .help[open] .help-list {
    animation: help-drop 0.18s ease-out;
  }

  .help-list > div {
    display: flex;
    justify-content: space-between;
    padding: 9px 4px;
  }

  .help-list > div + div {
    border-top: 1.5px solid #e8ddf2;
  }

  kbd {
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--color-lilac);
    box-shadow: inset 0 -3px #9a8ce0;
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
  }

  .status-area {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
    font-weight: 700;
  }

  .battery {
    position: relative;
    width: 30px;
    height: 15px;
    border: 2px solid currentcolor;
    border-radius: 4px;
  }

  .battery::before {
    position: absolute;
    inset: 2px 7px 2px 2px;
    border-radius: 1px;
    background: var(--color-mint);
    content: '';
  }

  .battery::after {
    position: absolute;
    top: 3px;
    right: -5px;
    width: 3px;
    height: 5px;
    border-radius: 0 1px 1px 0;
    background: currentcolor;
    content: '';
  }

  /* Sin JS no hay hora. */
  html:not(.js) .clock {
    display: none;
  }

  @keyframes help-drop {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  .folder {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 6px;
    padding-top: 14px;
    border-radius: 16px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .folder:hover,
  .folder:focus-visible {
    background: rgb(251 244 255 / 0.18);
    outline: none;
  }

  .folder:focus-visible {
    box-shadow: 0 0 0 3px var(--color-wall);
  }

  .folder[aria-pressed='true'] {
    background: rgb(251 244 255 / 0.3);
  }

  .folder-icon {
    overflow: visible;
    transition: translate 0.2s;
  }

  .folder:hover .folder-icon {
    translate: 0 -3px;
  }

  /* Tonos de la carpeta a partir del color del proyecto. */
  .folder-back {
    fill: color-mix(in oklab, var(--c), #5a2f6b 18%);
  }

  .folder-front {
    fill: var(--c);
  }

  .folder-lip {
    fill: color-mix(in oklab, var(--c), #fff 30%);
  }

  /* Elegida, se abre: el frente se inclina y asoma la hoja. */
  .folder-sheet {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 0.2s,
      translate 0.3s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .folder-open {
    opacity: 0;
  }

  .folder-open,
  .folder-closed {
    transition: opacity 0.15s;
  }

  .folder[aria-pressed='true'] .folder-sheet {
    opacity: 1;
    translate: 0 0;
  }

  .folder[aria-pressed='true'] .folder-open {
    opacity: 1;
  }

  .folder[aria-pressed='true'] .folder-closed {
    opacity: 0;
  }

  .folder-name {
    color: #fbf4ff;
    font-size: 15px;
    font-weight: 700;
    line-height: 18px;
    text-shadow: 0 2px 3px rgb(42 27 107 / 0.45);
  }

  .taskbar {
    position: absolute;
    top: 876px;
    left: 56px;
    width: 1488px;
    height: 48px;
    background: var(--color-plum);
  }

  .start {
    position: absolute;
    top: 8px;
    left: 24px;
    display: grid;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-pink);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 800;
    place-items: center;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--color-desk);
    color: var(--color-wall);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .tab:hover {
    background: var(--color-cabinet);
  }

  .tab[aria-current] {
    background: var(--color-wall);
    color: var(--color-plum);
  }

  /* La activa lleva una línea rosa abajo. */
  .tab::after {
    position: absolute;
    right: 14px;
    bottom: 0;
    left: 14px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-pink);
    content: '';
    opacity: 0;
    transition: opacity 0.2s;
  }

  .tab[aria-current]::after {
    opacity: 1;
  }

  .tab-number {
    font-size: 12px;
    opacity: 0.7;
  }

  @keyframes tab-flash {
    40% {
      background: var(--color-pink);
      color: var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop :global(*) {
      transition: none !important;
    }

    .help[open] .help-list {
      animation: none;
    }
  }
</style>
