<style>
  .cam {
    transform-origin: 0 0;
  }

  /* La pantalla del monitor (centro 260,162) queda centrada en la vista previa a ×3.4. */
  :global(:is([data-active], html:not(.js) :target)) .cam {
    animation: site-cam 7s 1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes site-cam {
    0%,
    15%,
    100% {
      transform: none;
    }

    45%,
    70% {
      transform: translate(-654px, -381px) scale(3.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:is([data-active], html:not(.js) :target)) .cam {
      animation: none;
    }
  }
</style>
