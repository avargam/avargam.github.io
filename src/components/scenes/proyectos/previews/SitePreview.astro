---
/**
 * Vista previa de este sitio (460×340): el cuarto en miniatura; la cámara entra al monitor, que
 * muestra este mismo escritorio, y vuelve. En bucle mientras la ventana está activa.
 */
---

<svg class="site" width="460" height="340" viewBox="0 0 460 340" aria-hidden="true">
  <g class="cam">
    <rect width="460" height="340" fill="#F9DDF0"></rect>
    <rect y="250" width="460" height="90" fill="#B676B0"></rect>
    <!-- ventana -->
    <rect
      x="18"
      y="40"
      width="130"
      height="90"
      rx="4"
      fill="#2A1B6B"
      stroke="#5A2F6B"
      stroke-width="4"
    ></rect>
    <rect x="18" y="95" width="130" height="35" fill="#FF6FA3"></rect>
    <circle cx="83" cy="100" r="14" fill="#FFE86B"></circle>
    <!-- corcho -->
    <rect
      x="160"
      y="34"
      width="100"
      height="62"
      rx="3"
      fill="#F2CBA2"
      stroke="#5A2F6B"
      stroke-width="4"
    ></rect>
    <rect x="170" y="44" width="22" height="20" fill="#FFE86B"></rect>
    <rect x="198" y="46" width="22" height="20" fill="#A8EBC8"></rect>
    <rect x="226" y="44" width="22" height="20" fill="#9ED8F0"></rect>
    <!-- estantería y escritorio -->
    <rect
      x="370"
      y="44"
      width="70"
      height="170"
      fill="#C08AB8"
      stroke="#5A2F6B"
      stroke-width="3"
    ></rect>
    <rect x="80" y="200" width="300" height="12" fill="#5A2F6B"></rect>
    <!-- monitor con el escritorio de Proyectos -->
    <rect x="200" y="128" width="104" height="66" rx="4" fill="#5A2F6B"></rect>
    <rect x="205" y="133" width="94" height="56" fill="#B28CFF"></rect>
    <circle cx="252" cy="171" r="12" fill="#FFE86B"></circle>
    <rect x="205" y="171" width="94" height="18" fill="#5B3FC6"></rect>
    <rect x="205" y="133" width="94" height="4" fill="#F9DDF0"></rect>
    <rect
      x="225"
      y="142"
      width="54"
      height="34"
      rx="2"
      fill="#F9DDF0"
      stroke="#5A2F6B"
      stroke-width="1.5"
    ></rect>
    <rect x="225" y="142" width="54" height="5" fill="#FF6FA3"></rect>
    <rect x="246" y="194" width="12" height="8" fill="#5A2F6B"></rect>
    <!-- persona -->
    <circle cx="150" cy="150" r="20" fill="#E7B48A"></circle>
    <path d="M130 146 a20 20 0 0 1 40 -4 l-6 -10 h-26z" fill="#2A1B6B"></path>
    <rect x="128" y="168" width="44" height="40" rx="14" fill="#FF6FA3"></rect>
  </g>
</svg>

<style>
  .cam {
    transform-origin: 0 0;
  }

  /* La pantalla del monitor (centro 252,161) queda centrada en la vista previa a ×3.4. */
  :global(:is([data-active], html:not(.js) :target)) .cam {
    animation: site-cam 7s 1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes site-cam {
    0%,
    15%,
    100% {
      transform: none;
    }

    45%,
    70% {
      transform: translate(-627px, -377px) scale(3.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:is([data-active], html:not(.js) :target)) .cam {
      animation: none;
    }
  }
</style>
