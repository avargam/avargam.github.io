---
/**
 * Vista previa del Recetario (460×340): una receta con el estilo neo-brutalista del proyecto; cada
 * paso se subraya y se convierte en íconos de la tarjeta recordatorio.
 */
const ICONS = {
  knife:
    '<path d="M4 22 L22 4 L26 8 L10 24 Z" fill="#fff" stroke="#1A1423" stroke-width="2.5" stroke-linejoin="round"/><path d="M10 24 L6 28" stroke="#1A1423" stroke-width="4" stroke-linecap="round"/>',
  onion:
    '<path d="M15 4 C9 12 5 15 5 20 a10 8 0 0 0 20 0 C25 15 21 12 15 4Z" fill="#E7B8FF" stroke="#1A1423" stroke-width="2.5"/><path d="M15 10 V26" stroke="#1A1423" stroke-width="2"/>',
  pan: '<ellipse cx="13" cy="16" rx="10" ry="6" fill="#444" stroke="#1A1423" stroke-width="2.5"/><path d="M23 15 H29" stroke="#1A1423" stroke-width="4" stroke-linecap="round"/><path d="M9 27 q2 -3 0 -5 M14 27 q2 -3 0 -5" stroke="#FF5A36" stroke-width="2.5" fill="none"/>',
  clock:
    '<circle cx="15" cy="15" r="11" fill="#fff" stroke="#1A1423" stroke-width="2.5"/><path d="M15 8 V15 L20 18" stroke="#1A1423" stroke-width="2.5" fill="none" stroke-linecap="round"/>',
  rice: '<path d="M4 14 h22 a11 10 0 0 1 -22 0Z" fill="#fff" stroke="#1A1423" stroke-width="2.5"/><circle cx="11" cy="11" r="2" fill="#fff" stroke="#1A1423" stroke-width="1.5"/><circle cx="16" cy="9" r="2" fill="#fff" stroke="#1A1423" stroke-width="1.5"/><circle cx="20" cy="11" r="2" fill="#fff" stroke="#1A1423" stroke-width="1.5"/>',
  spoon:
    '<ellipse cx="10" cy="10" rx="5" ry="7" transform="rotate(-45 10 10)" fill="#fff" stroke="#1A1423" stroke-width="2.5"/><path d="M13 13 L26 26" stroke="#1A1423" stroke-width="4" stroke-linecap="round"/>',
};

const steps = [
  {
    before: 'Pica la ',
    word: 'cebolla',
    after: ' en cubos',
    icons: [
      ['knife', '#B69CFF'],
      ['onion', '#9BE564'],
    ],
  },
  {
    before: '',
    word: 'Sofríe',
    after: ' en aceite por 5 min',
    icons: [
      ['pan', '#FFD23F'],
      ['clock', '#B69CFF'],
    ],
  },
  {
    before: 'Agrega el ',
    word: 'arroz',
    after: ' y revuelve',
    icons: [
      ['rice', '#9BE564'],
      ['spoon', '#FFD23F'],
    ],
  },
] as const;
---

<div class="recetario" aria-hidden="true">
  <div class="card">
    <p class="card-title">Arroz graneado</p>
    {steps.map((step, s) => (
      <div class="step" style={`--s:${s}`}>
        <p class="step-text">
          {s + 1}. {step.before}
          <mark>{step.word}</mark>
          {step.after}
        </p>
        <div class="icons">
          {step.icons.map(([icon, color], k) => (
            <span class="icon" style={`--c:${color};--k:${k}`}>
              <svg width="30" height="30" viewBox="0 0 30 30" set:html={ICONS[icon]} />
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .recetario {
    position: absolute;
    inset: 0;
    background: #fff6e0;
  }

  .card {
    position: absolute;
    top: 22px;
    left: 22px;
    width: 410px;
    height: 290px;
    border: 3px solid #1a1423;
    background: #fff;
    box-shadow: 6px 6px 0 #1a1423;
  }

  .card-title {
    padding: 10px 14px;
    border-bottom: 3px solid #1a1423;
    background: #ffd23f;
    color: #1a1423;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
  }

  .step {
    display: grid;
    height: 72px;
    align-items: center;
    padding: 0 12px;
    border-bottom: 2px dashed #1a1423;
    grid-template-columns: 1fr 110px;
  }

  .step:last-child {
    border: 0;
  }

  .step-text {
    color: #1a1423;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  mark {
    background: linear-gradient(#9be564, #9be564) 0 85% / 0% 40% no-repeat;
    color: inherit;
  }

  .icons {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .icon {
    display: grid;
    width: 44px;
    height: 44px;
    border: 3px solid #1a1423;
    background: var(--c);
    box-shadow: 3px 3px 0 #1a1423;
    opacity: 0;
    place-items: center;
  }

  /* Cada paso: se subraya la palabra clave y luego caen sus íconos como timbres. */
  :global(:is([data-active], html:not(.js) :target)) mark {
    animation: recetario-marker 0.5s calc(0.9s + var(--s) * 1.1s) forwards;
  }

  :global(:is([data-active], html:not(.js) :target)) .icon {
    animation: recetario-stamp 0.35s calc(1.3s + var(--s) * 1.1s + var(--k) * 0.15s)
      cubic-bezier(0.3, 1.6, 0.5, 1) forwards;
  }

  @keyframes recetario-marker {
    to {
      background-size: 100% 40%;
    }
  }

  @keyframes recetario-stamp {
    from {
      opacity: 0;
      rotate: -12deg;
      scale: 1.8;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    mark {
      background-size: 100% 40%;
    }

    .icon {
      opacity: 1;
    }

    :global(:is([data-active], html:not(.js) :target)) * {
      animation: none !important;
    }
  }
</style>
