---
/**
 * Capa HTML de Proyectos (escala 1:1 sobre la escena): solo Volver y el título para lectores de
 * pantalla. Los chips son la barra de tareas y la pista va en el menú Ayuda, los dos en la escena.
 * Además, da la hora del reloj del escritorio.
 */
import { getSection } from '../../../data/sections';
import SectionShell from '../../ui/SectionShell.astro';

interface Props {
  active: boolean;
}

const { active } = Astro.props;
---

<SectionShell section={getSection('proyectos')} active={active} hideTitle />

<script>
  import { createItemNav } from '../../stage/itemNav';
  import { panToSceneRect, registerSection } from '../../stage/router';
  import { WINDOW, proyectosItem, proyectosItems } from './desk';

  const nav = createItemNav({
    slug: 'proyectos',
    ids: proyectosItems.map((i) => i.id),
    describe: (id) => proyectosItem(id)?.name ?? '',
    // La ventana se abre en cuanto se elige; en el teléfono, la cámara centra su mitad del texto.
    focus(id, instant) {
      const text = { ...WINDOW, x: WINDOW.x + WINDOW.w / 2, w: WINDOW.w / 2 };
      if (id) void panToSceneRect('proyectos', text, instant);
      return Promise.resolve(true);
    },
  });
  if (nav) registerSection('proyectos', nav);

  // La hora de la barra de menú del escritorio, al minuto.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const tick = () => {
    const now = new Date();
    if (clock)
      clock.textContent = now.toLocaleTimeString('es-CL', {
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      });
    setTimeout(tick, 60_000 - (now.getTime() % 60_000));
  };
  tick();
</script>
