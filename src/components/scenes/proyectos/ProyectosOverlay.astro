---
/**
 * Capa HTML de Proyectos (escala 1:1 sobre la escena): solo Volver y el título para lectores de
 * pantalla. Los chips son la barra de tareas y la pista va en el menú Ayuda, los dos en la escena.
 */
import { getSection } from '../../../data/sections';
import SectionShell from '../../ui/SectionShell.astro';

interface Props {
  active: boolean;
}

const { active } = Astro.props;
---

<SectionShell section={getSection('proyectos')} active={active} hideTitle />

<script>
  import { createItemNav } from '../../stage/itemNav';
  import { registerSection } from '../../stage/router';
  import { proyectosItem, proyectosItems } from './desk';

  const nav = createItemNav({
    slug: 'proyectos',
    ids: proyectosItems.map((i) => i.id),
    describe: (id) => proyectosItem(id)?.name ?? '',
    // La ventana se abre en cuanto se elige: no hay cámara ni espera.
    focus: () => Promise.resolve(true),
  });
  if (nav) registerSection('proyectos', nav);
</script>
