---
/**
 * El cuarto: navegación del sitio. Todas las rutas lo renderizan; `initial` indica qué sección
 * viene abierta (deep link). Provisional (Fase 0): objetos y escenas son cajas de prueba.
 */
import { profile } from '../../data/profile';
import { getSection, sections, type SectionSlug } from '../../data/sections';
import World from '../stage/World.astro';
import TestBox from '../stage/TestBox.astro';
import SectionChips from '../ui/SectionChips.astro';
import SectionOverlay from './SectionOverlay.astro';
import { objectRect, rectStyle, sceneInObject } from '../stage/geometry';

interface Props {
  initial?: SectionSlug;
}

const { initial } = Astro.props;
const open = initial ? getSection(initial) : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const testColors: Record<SectionSlug, string> = {
  formacion: 'var(--color-periwinkle)',
  experiencia: 'var(--color-peach)',
  proyectos: 'var(--color-lilac)',
  'fuera-del-codigo': 'var(--color-mint)',
  contacto: 'var(--color-sun)',
};
---

<div data-room-root>
  <World initial={open}>
    <div class="room-bg absolute inset-0" data-room-only inert={!!open} aria-hidden="true">
      <p class="font-display text-plum/40 absolute bottom-40 left-10 text-5xl font-extrabold">
        Cuarto (provisional)
      </p>
    </div>

    {sections.map((s) => (
      <div class="room-object absolute" style={rectStyle(objectRect(s))}>
        {s.transition === 'zoom' && (
          <div class="absolute inset-0 overflow-hidden">
            <div
              class="absolute top-0 left-0 h-[1000px] w-[1600px] origin-top-left"
              style={`transform: ${sceneInObject(s)}`}
              data-scene={s.slug}
              inert={s.slug !== initial}
            >
              <TestBox label={`Escena ${s.label}`} color={testColors[s.slug]} />
            </div>
          </div>
        )}
        {s.transition === 'tilt' && (
          <div class="bg-pink border-plum absolute inset-0 rounded border-3" aria-hidden="true" />
        )}
        <a
          href={`${base}/${s.slug}`}
          data-section={s.slug}
          data-hotspot={s.slug}
          data-room-only
          inert={!!open}
          aria-label={s.label}
          class="room-hotspot absolute inset-0"
        />
      </div>
    ))}

    <div slot="overlay" class="contents">
      <div
        data-room-ui
        data-room-only
        hidden={!!open}
        inert={!!open}
        class="absolute inset-x-0 bottom-6 flex flex-col items-center gap-3"
      >
        <h1 class="sr-only">{profile.name}</h1>
        <SectionChips label="Secciones del cuarto" />
        <p class="text-plum text-lg">
          Haz clic en un objeto · o usa Tab y las flechas · Enter para entrar
        </p>
      </div>

      {sections.map((s) => (
        <SectionOverlay section={s} active={s.slug === initial} color={testColors[s.slug]} />
      ))}

      <p data-announcer class="sr-only" aria-live="polite"></p>
    </div>
  </World>
</div>

<script>
  import { initRouter } from '../stage/router';

  initRouter();
</script>

<style>
  .room-bg {
    background: linear-gradient(
      var(--color-wall) 0 64%,
      var(--color-wall-deep) 64% 76%,
      var(--color-floor) 76%
    );
  }

  .room-hotspot {
    border-radius: 6px;
  }

  .room-hotspot:hover,
  .room-hotspot:focus-visible {
    outline: 5px dashed var(--color-hotpink);
    outline-offset: 8px;
  }

  .room-hotspot[inert] {
    pointer-events: none;
  }
</style>
