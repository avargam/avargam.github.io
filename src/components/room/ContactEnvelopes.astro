---
/** Objeto de Contacto: dos sobres sobre el escritorio. El viewBox coincide con su `object` en sections.ts. */
import type { Rect } from '../stage/geometry';

interface Props {
  rect: Rect;
}

const { x, y, w, h } = Astro.props.rect;
---

<svg
  class="absolute inset-0 h-full w-full overflow-visible"
  viewBox={`${x} ${y} ${w} ${h}`}
  aria-hidden="true"
>
  <g transform="translate(106 0)">
    <g transform="rotate(-6 960 580)">
      <rect
        x="930"
        y="562"
        width="62"
        height="28"
        rx="3"
        fill="#FFF3E2"
        stroke="#5A2F6B"
        stroke-width="3"
      />
      <path
        d="M930 564 L961 580 L992 564"
        fill="none"
        stroke="#5A2F6B"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
    </g>
    <g transform="rotate(5 962 566)">
      <rect
        x="934"
        y="548"
        width="58"
        height="26"
        rx="3"
        fill="#FF6FA3"
        stroke="#5A2F6B"
        stroke-width="3"
      />
      <path
        d="M934 550 L963 565 L992 550"
        fill="none"
        stroke="#5A2F6B"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
      <circle cx="963" cy="565" r="5" fill="#FFE86B" stroke="#5A2F6B" stroke-width="2" />
    </g>
  </g>
</svg>
