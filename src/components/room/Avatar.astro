    <path d="M613 380H622L618 401Q614 401 613 396Z" fill="#2B2D42" />
    <path
      d="M638 382L651 380"
      fill="none"
      stroke="#2B2D42"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
