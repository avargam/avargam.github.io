</g>

<style>
  .av-breath,
  .av-head,
  .av-eye {
    animation-play-state: var(--ambient-state, paused);
    transform-box: fill-box;
  }

  /* Respira: el torso se infla apenas y la cabeza sube con él. */
  .av-breath {
    animation: av-breath 3.8s ease-in-out infinite;
    transform-origin: 50% 100%;
  }

  .av-head {
    animation: av-head 3.8s ease-in-out infinite;
  }

  /* Parpadea cada cinco segundos. */
  .av-eye {
    animation: av-blink 5s infinite;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .av-breath,
    .av-head,
    .av-eye {
      animation: none;
    }
  }

  @keyframes av-breath {
    50% {
      transform: scale(1.012, 1.022);
    }
  }

  @keyframes av-head {
    50% {
      transform: translateY(-2.5px);
    }
  }

  @keyframes av-blink {
    0%,
    94%,
    100% {
      transform: none;
    }
    97% {
      transform: scaleY(0.1);
    }
  }
</style>
