---
/**
 * Ilustración del cuarto (todo lo que no es un objeto navegable), portada de
 * `prototype/final/L_cuarto_nuevo_plano.svg`. Va debajo de los objetos: nada de aquí puede
 * tapar el rect de un objeto, o aparecería encima de su escena durante el zoom.
 */
import Avatar from './Avatar.astro';
import Cat from './Cat.astro';
---

<svg class="absolute inset-0" viewBox="0 0 1600 1000" aria-hidden="true">
  <!-- pared y piso -->
  <rect width="1600" height="1000" fill="#F9DDF0" />
  <rect y="640" width="1600" height="130" fill="#EDB8DC" />
  <rect y="640" width="1600" height="10" fill="#D58FC4" />
  <rect y="760" width="1600" height="240" fill="#B676B0" />
  <path
    d="M0 830H1600M0 900H1600M0 965H1600M300 760V830M820 760V830M1280 760V830M120 830V900M560 830V900M1040 830V900M1450 830V900M420 900V965M900 900V965M1360 900V965"
    stroke="#9C5C98"
    stroke-width="3"
  />

  <!-- alfombra -->
  <ellipse cx="800" cy="890" rx="470" ry="78" fill="#8B6CF0" />
  <ellipse
    cx="800"
    cy="890"
    rx="420"
    ry="62"
    fill="none"
    stroke="#FDE7F5"
    stroke-width="6"
    stroke-dasharray="4 14"
    stroke-linecap="round"
  />
  <ellipse cx="800" cy="890" rx="330" ry="46" fill="#B49CF8" />

  <Avatar />

  <!-- escritorio -->
  <rect x="470" y="590" width="720" height="26" rx="8" fill="#7D4690" />
  <rect x="470" y="610" width="720" height="8" fill="#5A2F6B" />
  <rect x="486" y="616" width="24" height="146" fill="#5A2F6B" />
  <rect x="1150" y="616" width="24" height="146" fill="#5A2F6B" />
  <rect x="1000" y="616" width="150" height="70" rx="6" fill="#5A2F6B" />
  <rect x="1060" y="646" width="30" height="8" rx="3" fill="#E8B3DA" />

  <!-- pie del monitor (la pantalla es la escena de Proyectos) -->
  <rect x="840" y="560" width="40" height="30" fill="#3A3F5C" />
  <rect x="810" y="584" width="100" height="8" rx="4" fill="#3A3F5C" />

  <!-- teclado -->
  <rect x="740" y="576" width="160" height="14" rx="5" fill="#E6E6EF" />

  <!-- taza (en el extremo izquierdo, para dejar lugar a los sobres de Contacto) -->
  <g transform="translate(-548 0)">
    <rect x="1030" y="552" width="42" height="38" rx="6" fill="#FFFFFF" />
    <path
      d="M1072 562 Q1090 564 1086 578 Q1082 586 1072 584"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="6"
    />
    <path
      class="steam"
      d="M1042 540 Q1036 528 1044 518 M1056 540 Q1050 526 1058 514"
      fill="none"
      stroke="#B9A894"
      stroke-width="3"
      stroke-linecap="round"
    />
  </g>

  <!-- lámpara -->
  <path
    d="M1126 590 L1126 540 L1096 470"
    fill="none"
    stroke="#3A3F5C"
    stroke-width="8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <rect x="1104" y="580" width="48" height="12" rx="5" fill="#3A3F5C" />
  <path d="M1062 444 L1132 424 L1146 476 L1090 496Z" fill="#FFC857" />
  <polygon points="1080,490 1142,474 1190,590 1020,590" fill="#FFE9A8" opacity="0.35" />

  <!-- gabinete bajo la estantería (las 4 repisas son la escena de Fuera del código) -->
  <rect
    x="1240"
    y="489"
    width="272"
    height="241"
    rx="6"
    fill="#7D4690"
    stroke="#5A2F6B"
    stroke-width="4"
  />
  <rect
    x="1250"
    y="503"
    width="122"
    height="212"
    rx="4"
    fill="#9B5BB0"
    stroke="#5A2F6B"
    stroke-width="3"
  />
  <rect
    x="1380"
    y="503"
    width="122"
    height="212"
    rx="4"
    fill="#9B5BB0"
    stroke="#5A2F6B"
    stroke-width="3"
  />
  <circle cx="1362" cy="610" r="6" fill="#FFE86B" />
  <circle cx="1394" cy="610" r="6" fill="#FFE86B" />

  <Cat />
</svg>

<style>
  /* Vapor de la taza: sube, se ondula y se desvanece. */
  .steam {
    animation: steam 3.2s ease-in-out infinite;
    animation-play-state: var(--ambient-state, paused);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .steam {
      animation: none;
    }
  }

  @keyframes steam {
    0% {
      opacity: 0;
      transform: translateY(6px) scaleY(0.8);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-10px) skewX(-8deg);
    }
  }
</style>
