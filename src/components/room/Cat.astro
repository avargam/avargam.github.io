---
/** Gato tuxedo echado como pan sobre la alfombra: negro, con antifaz, pecho y patas blancas y ojos verdes. */
---

<g>
  <ellipse cx="1000" cy="906" rx="92" ry="10" fill="#2A1B6B" opacity=".2" />
  <path
    d="M1062 892Q1040 912 986 908"
    fill="none"
    stroke="#2A2438"
    stroke-width="14"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <g class="cat-breath">
    <path
      d="M928 900C922 860 944 826 996 824C1046 822 1072 852 1070 882C1068 900 1052 906 1026 906H962C942 906 930 906 928 900Z"
      fill="#2A2438"
    />
    <path
      d="M972 834Q1012 822 1050 842"
      fill="none"
      stroke="#463D5C"
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity=".9"
    />
  </g>
  <ellipse cx="950" cy="880" rx="22" ry="24" fill="#FBF4FF" />
  <ellipse cx="938" cy="904" rx="11" ry="5.5" fill="#FBF4FF" />
  <ellipse cx="962" cy="905" rx="11" ry="5.5" fill="#FBF4FF" />
  <g class="cat-head">
    <path d="M920 826L924 794L944 814Z" fill="#2A2438" />
    <path d="M925 818L927 803L937 813Z" fill="#FF8DB8" />
    <path d="M954 812L970 788L976 820Z" fill="#2A2438" />
    <path d="M958 812L968 797L971 815Z" fill="#FF8DB8" />
    <path
      d="M914 838C914 816 930 804 948 804C968 804 982 818 982 838C982 858 966 868 948 868C930 868 914 858 914 838Z"
      fill="#2A2438"
    />
    <path
      d="M948 818Q954 832 962 846Q966 862 948 864Q930 863 934 846Q942 832 948 818Z"
      fill="#FBF4FF"
    />
    <ellipse cx="934" cy="834" rx="6" ry="4.5" fill="#C5E86C" />
    <ellipse cx="962" cy="834" rx="6" ry="4.5" fill="#C5E86C" />
    <ellipse cx="934" cy="834" rx="1.6" ry="4" fill="#2B2D42" />
    <ellipse cx="962" cy="834" rx="1.6" ry="4" fill="#2B2D42" />
    <g class="cat-lid">
      <path d="M927 834Q934 826 941 834Z" fill="#2A2438" />
      <path d="M955 834Q962 826 969 834Z" fill="#2A2438" />
    </g>
    <path d="M944 848H952L948 853Z" fill="#FF8DB8" />
    <path
      d="M948 853V856M948 856Q944 859 941 857M948 856Q952 859 955 857"
      fill="none"
      stroke="#B9A8C9"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M936 852L914 848M936 856L915 859M960 852L982 847M960 856L981 859"
      fill="none"
      stroke="#C6B8FF"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity=".75"
    />
  </g>
</g>

<style>
  .cat-breath,
  .cat-lid {
    animation-play-state: var(--ambient-state, paused);
    transform-box: fill-box;
  }

  /* Respira: el lomo sube y baja despacio. */
  .cat-breath {
    animation: cat-breath 3.4s ease-in-out infinite;
    transform-origin: 50% 100%;
  }

  /* Parpadeo lento: los párpados bajan y se quedan un momento. */
  .cat-lid {
    animation: cat-blink 6s ease-in-out infinite;
    transform-origin: 50% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-breath,
    .cat-lid {
      animation: none;
    }
  }

  @keyframes cat-breath {
    50% {
      transform: scale(1.02, 1.06);
    }
  }

  @keyframes cat-blink {
    0%,
    60%,
    100% {
      transform: scaleY(1);
    }
    72%,
    84% {
      transform: scaleY(2.6);
    }
  }
</style>
