---
/** Gato tuxedo durmiendo sobre la alfombra: negro, con hocico, pecho y patas blancas. */
---

<g>
  <path
    d="M1040 868 Q1118 860 1090 836"
    fill="none"
    stroke="#2A2438"
    stroke-width="12"
    stroke-linecap="round"
  />
  <ellipse class="breath" cx="990" cy="856" rx="78" ry="40" fill="#2A2438" />
  <!-- brillo del lomo -->
  <path
    d="M960 830 Q995 818 1030 830"
    fill="none"
    stroke="#463D5C"
    stroke-width="6"
    stroke-linecap="round"
  />
  <ellipse cx="954" cy="878" rx="24" ry="16" fill="#FBF4FF" />
  <ellipse cx="936" cy="892" rx="13" ry="7" fill="#FBF4FF" />
  <ellipse cx="962" cy="894" rx="13" ry="7" fill="#FBF4FF" />
  <circle cx="926" cy="846" r="30" fill="#2A2438" />
  <path d="M906 826 L910 800 L928 820Z M942 820 L956 798 L960 826Z" fill="#2A2438" />
  <path d="M911 820 L913 808 L922 818Z M946 818 L953 807 L955 821Z" fill="#FF8DB8" />
  <!-- antifaz: la mancha blanca baja entre los ojos hasta el hocico -->
  <path
    d="M931 828 Q936 840 942 852 Q945 866 928 868 Q911 867 914 854 Q921 842 931 828Z"
    fill="#FBF4FF"
  />
  <path d="M926 853 L934 853 L930 858Z" fill="#FF8DB8" />
  <path
    d="M910 844 Q917 850 923 845 M940 845 Q946 850 952 844"
    fill="none"
    stroke="#C6B8FF"
    stroke-width="3"
    stroke-linecap="round"
  />
</g>

<style>
  /* Respira: el lomo sube y baja despacio. */
  .breath {
    animation: breath 3.6s ease-in-out infinite;
    animation-play-state: var(--ambient-state, paused);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .breath {
      animation: none;
    }
  }

  @keyframes breath {
    50% {
      transform: scale(1.025, 1.07);
    }
  }
</style>
