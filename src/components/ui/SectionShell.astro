---
/**
 * Armazón de la capa HTML de una sección (escala 1:1 sobre la escena): Volver, título,
 * contenido, chips y pista de teclado. El contenido entra escalonado al mostrarse.
 */
import type { Section } from '../../data/sections';

interface Props {
  section: Section;
  active: boolean;
  /** El diseño de algunas escenas no muestra el título: queda solo para lectores de pantalla. */
  hideTitle?: boolean;
  /** Pista de teclado abajo. Proyectos no la usa: va en el menú Ayuda de su escena. */
  hint?: string;
  /** Pista en pantallas táctiles (sin teclado): reemplaza a `hint`. */
  touchHint?: string;
  /** Sobre un fondo oscuro (la mesa de Contacto), la pista va clara. */
  hintTone?: 'dark' | 'light';
}

const { section, active, hideTitle = false, hint, touchHint, hintTone = 'dark' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const titleId = `titulo-${section.slug}`;
---

<section
  data-overlay={section.slug}
  aria-labelledby={titleId}
  hidden={!active}
  class="section-shell pointer-events-none absolute inset-0"
>
  <h1 id={titleId} tabindex="-1" class:list={[hideTitle && 'sr-only']}>
    {section.label}
  </h1>

  <slot />

  <a
    href={`${base}/`}
    data-back
    data-screen="top-left"
    class="shell-enter bg-plum text-wall pointer-events-auto absolute top-[56px] left-[40px] flex h-[52px] items-center gap-3 rounded-full px-6 text-[20px] font-bold no-underline shadow-[0_6px_0_rgb(43_45_66/0.25)]"
  >
    <svg width="28" height="20" viewBox="0 0 28 20" aria-hidden="true">
      <path
        d="M27 10H3M11 2 3 10l8 8"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    Volver al cuarto
  </a>

  <div
    class="shell-enter pointer-events-auto absolute top-[920px] left-1/2 -translate-x-1/2"
    style="--i: 2"
    data-screen="bottom"
  >
    <slot name="chips" />
  </div>
  {(hint || touchHint) && (
    <p
      data-screen="hint"
      class:list={[
        'shell-enter absolute top-[978px] left-0 w-full text-center text-[15px] font-semibold',
        hintTone === 'dark'
          ? 'text-plum [text-shadow:0_0_4px_var(--color-wall),0_0_8px_var(--color-wall),0_0_12px_var(--color-wall)]'
          : 'text-wall [text-shadow:0_0_4px_var(--color-plum),0_0_8px_var(--color-plum)]',
      ]}
      style="--i: 3"
    >
      {hint && <span data-hint={touchHint ? 'keys' : undefined}>{hint}</span>}
      {touchHint && <span data-hint="touch">{touchHint}</span>}
    </p>
  )}
</section>

<style>
  .section-shell:not([hidden]) .shell-enter,
  .section-shell:not([hidden]) :global(.shell-enter) {
    animation: shell-in 0.25s ease-out both;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  @keyframes shell-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-shell:not([hidden]) .shell-enter,
    .section-shell:not([hidden]) :global(.shell-enter) {
      animation: none;
    }
  }
</style>
