---
import { sections, type SectionSlug } from '../../data/sections';

interface Props {
  current?: SectionSlug;
  label: string;
}

const { current, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav aria-label={label}>
  <ul class="flex gap-3">
    {sections.map((s) => {
      const active = s.slug === current;
      return (
        <li>
          <a
            href={`${base}/${s.slug}`}
            data-section={s.slug}
            data-chip={s.slug}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'border-plum flex h-[42px] items-center gap-3 rounded-full border-3 pr-5 pl-2 text-[16px] font-bold whitespace-nowrap no-underline',
              active ? 'bg-plum text-wall' : 'text-plum hover:bg-sun bg-white',
            ]}
          >
            <span
              class:list={[
                'text-ink grid size-[26px] place-items-center rounded-full text-[13px] font-extrabold',
                active ? 'bg-pink' : 'bg-lilac',
              ]}
              aria-hidden="true"
            >
              {s.key}
            </span>
            {s.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
