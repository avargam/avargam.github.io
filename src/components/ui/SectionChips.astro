---
import { sections, type SectionSlug } from '../../data/sections';

interface Props {
  current?: SectionSlug;
  label: string;
}

const { current, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav aria-label={label}>
  <ul class="flex gap-3">
    {sections.map((s) => {
      const active = s.slug === current;
      return (
        <li>
          <a
            href={`${base}/${s.slug}`}
            data-section={s.slug}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'border-plum flex items-center gap-3 rounded-full whitespace-nowrap border-3 py-2 pr-6 pl-2 text-xl font-medium no-underline',
              active ? 'bg-plum text-wall' : 'text-plum hover:bg-sun bg-white',
            ]}
          >
            <span
              class:list={[
                'grid size-8 place-items-center rounded-full text-base font-bold',
                active ? 'bg-pink text-plum' : 'bg-lilac',
              ]}
              aria-hidden="true"
            >
              {s.key}
            </span>
            {s.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
