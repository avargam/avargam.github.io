---
/** Página no encontrada: la placa del cuarto con el gato durmiendo y la vuelta al cuarto. */
import '../styles/global.css';
import Head from '../components/Head.astro';
import Cat from '../components/room/Cat.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <Head title="No encontrado" description="Esta página no existe." />
  </head>
  <body class="bg-wall grid min-h-dvh place-items-center p-6">
    <main class="flex max-w-md flex-col items-center gap-6 text-center">
      <svg class="w-56" viewBox="850 790 270 110" aria-hidden="true">
        <Cat />
      </svg>
      <div class="bg-wall border-plum rounded-2xl border-4 px-8 py-6 shadow-[8px_10px_0_var(--color-plum)]">
        <p class="text-plum text-sm font-extrabold tracking-[0.2em]">ERROR 404</p>
        <h1 class="mt-2 text-4xl font-extrabold">Esta página no existe</h1>
        <p class="text-muted mt-3">
          Puede que el enlace esté mal escrito o que la sección se haya movido. El gato tampoco la
          encontró.
        </p>
      </div>
      <a
        href={`${base}/`}
        class="bg-plum text-wall flex h-[52px] items-center gap-3 rounded-full px-6 text-lg font-bold no-underline shadow-[0_6px_0_rgb(43_45_66/0.25)]"
      >
        <span aria-hidden="true">←</span> Volver al cuarto
      </a>
    </main>
  </body>
</html>
