---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Card from '../components/Card.astro';
import { topics } from '../data/personal';
---

<BaseLayout
  title="Fuera del código"
  description="Juegos, música, anime y lecturas de Alonso Vargas."
>
  <PageIntro eyebrow="Lo que me gusta" title="Fuera del código">
    <p>Lo que hago cuando no estoy programando.</p>
  </PageIntro>

  <div class="grid gap-6 md:grid-cols-2">
    {topics.map((t) => (
      <Card as="article" class="scroll-mt-6">
        <h2 id={t.id} class="text-2xl font-bold">
          {t.title}
        </h2>
        <p class="text-muted mt-2">{t.blurb}</p>
        <ul class="mt-4 list-disc space-y-1 pl-5">
          {t.favorites.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </Card>
    ))}
  </div>
</BaseLayout>
